// =============================================================================
// ── DOMAIN 1 · TENANCY & IDENTITY ───────────────────────────────────────────
// =============================================================================

/// Core clinic/center identity record.
/// One Tenant = one logical clinic organisation (may have multiple Branches).
model Tenant {
  id                   String               @id @default(uuid()) @db.Uuid
  name                 String               @db.VarChar(255)
  /// URL-safe slug used for subdomain routing (e.g. "damascus-dental")
  slug                 String               @unique @db.VarChar(100)
  /// Custom white-label domain (Enterprise plan only)
  customDomain         String?              @db.VarChar(255)
  status               TenantStatus         @default(ACTIVE)
  lifecycleStatus      TenantLifecycleStatus @default(TRIAL)
  timezone             String               @default("UTC") @db.VarChar(50)
  /// BCP-47 locale code, e.g. "ar-SY" or "en-US"
  locale               String               @default("ar-SY") @db.VarChar(10)
  dataRetentionDays    Int                  @default(365)
  /// Feature flags JSONB: { is_self_booking_enabled: bool, ... }
  features             Json                 @default("{}")
  trialStartedAt       DateTime?
  trialEndsAt          DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  deletedAt            DateTime?

  // Relations
  branches             Branch[]
  users                User[]
  staffInvitations     StaffInvitation[]
  departments          Department[]
  userBranchAccess     UserBranchAccess[]
  customRoles          CustomRole[]
  userCustomRoles      UserCustomRole[]
  userSavedFilters     UserSavedFilter[]
  staffWeeklySchedules StaffWeeklySchedule[]
  regions              Region[]
  userRegionAccess     UserRegionAccess[]
  patients             Patient[]
  appointments         Appointment[]
  appointmentWaitlist  AppointmentWaitlist[]
  schedulingResources  SchedulingResource[]
  appointmentTemplates AppointmentTemplate[]
  branchOperatingHours BranchOperatingHours[]
  providerWeeklySchedules ProviderWeeklySchedule[]
  encounters           Encounter[]
  clinicalNoteTemplates ClinicalNoteTemplate[]
  inventoryItems       InventoryItem[]
  inventorySuppliers   InventorySupplier[]
  purchaseOrders       PurchaseOrder[]
  inventoryWarehouses  InventoryWarehouse[]
  invoices             Invoice[]
  invoiceRefunds       InvoiceRefund[]
  creditNotes          CreditNote[]
  cashSessions         CashSession[]
  invoiceWriteOffs     InvoiceWriteOff[]
  paymentPlans         PaymentPlan[]
  servicePrices        ServicePrice[]
  paymentReceipts      PaymentReceipt[]
  billingSequences     TenantBillingSequence[]
  commissionRules      CommissionRule[]
  commissions          CommissionCalculation[]
  queueTickets         QueueTicket[]
  loyaltyAccounts      LoyaltyAccount[]
  loyaltyRewards       LoyaltyReward[]
  clinicSubscriptions  ClinicSubscription[]
  portalAccounts       PortalAccount[]
  notifications        Notification[]
  notificationTemplates NotificationTemplate[]
  notificationPreferences NotificationPreference[]
  notificationAutomationRules NotificationAutomationRule[]
  tenantChannelConfigs TenantChannelConfig[]
  notificationSavedFilters NotificationSavedFilter[]
  notificationIntents      NotificationIntent[]
  notificationMessages     NotificationMessage[]
  deliveryJobs             DeliveryJob[]
  deliveryAttempts         DeliveryAttempt[]
  notificationReceipts     NotificationReceipt[]
  notificationDeadLetters  NotificationDeadLetter[]
  notificationConsentDecisions NotificationConsentDecision[]
  notificationPreferenceSnapshots NotificationPreferenceSnapshot[]
  workflows            Workflow[]
  workflowTemplates    WorkflowTemplate[]
  workflowTasks        WorkflowTask[]
  workflowApprovals    WorkflowApproval[]
  workflowAutomationRules WorkflowAutomationRule[]
  workflowSavedFilters WorkflowSavedFilter[]
  aiModels             AiModel[]
  aiConversations      AiConversation[]
  aiPrompts            AiPrompt[]
  aiUsageDaily         AiUsageDaily[]
  aiTenantSettings     AiTenantSettings?
  auditEntries         AuditEntry[]
  licenseAuditEvents   LicenseAuditEvent[]
  licenseLifecycleState TenantLicenseLifecycleState?
  licenseLifecycleTransitions LicenseLifecycleTransition[]
  communicationDispatchLedger CommunicationDispatchLedger[]
  mediaAssets          MediaAsset[]
  platformTenant       PlatformTenant?
  userDashboardLayouts UserDashboardLayout[]
  analyticsReports     AnalyticsReportRecord[]
  analyticsMetricRecords AnalyticsMetricRecord[]
  operationalReports   OperationalReportRecord[]
  reportShares         ReportShareRecord[]
  reportFilterPresets  ReportFilterPresetRecord[]
  reportCustomDefinitions ReportCustomDefinitionRecord[]
  analyticsFilterPresets AnalyticsFilterPresetRecord[]
  analyticsLayouts       AnalyticsLayoutRecord[]
  analyticsDashboards    AnalyticsDashboardRecord[]
  importExportJobs       ImportExportJob[]
  importExportDeadLetters ImportExportDeadLetter[]
  importExportArtifacts  ImportExportArtifact[]

  @@index([slug])
  @@index([status])
  @@index([lifecycleStatus])
  @@index([deletedAt])
  @@map("tenants")
}

/// Physical or logical clinic branch within a Tenant organisation.
model Branch {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  regionId    String?   @db.Uuid
  name        String    @db.VarChar(255)
  nameAr      String?   @db.VarChar(255)
  address     String?   @db.Text
  city        String?   @db.VarChar(100)
  phone       String?   @db.VarChar(30)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  region      Region?   @relation(fields: [regionId], references: [id], onDelete: SetNull)
  departments Department[]
  userBranchAccess UserBranchAccess[]

  @@index([tenantId])
  @@index([tenantId, isActive])
  @@map("branches")
}

enum EmploymentStatus {
  ACTIVE
  SUSPENDED
  ON_LEAVE
  ARCHIVED
  TERMINATED
}

enum BranchAccessMode {
  SINGLE
  MULTI
  GLOBAL
}

/// Geographic region grouping branches for regional access control.
model Region {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  name      String   @db.VarChar(255)
  nameAr    String?  @db.VarChar(255)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branches       Branch[]
  userRegionAccess UserRegionAccess[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("regions")
}

/// Regional access grants for staff users.
model UserRegionAccess {
  id       String   @id @default(uuid()) @db.Uuid
  tenantId String   @db.Uuid
  userId   String   @db.Uuid
  regionId String   @db.Uuid
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  region Region @relation(fields: [regionId], references: [id], onDelete: Cascade)

  @@unique([userId, regionId])
  @@index([tenantId, userId])
  @@map("user_region_access")
}

/// Organizational department within a tenant (optionally scoped to a branch).
model Department {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  branchId  String?  @db.Uuid
  name      String   @db.VarChar(255)
  nameAr    String?  @db.VarChar(255)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  users  User[]

  @@index([tenantId])
  @@index([tenantId, branchId])
  @@map("departments")
}

/// Multi-branch access grants for staff users.
model UserBranchAccess {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  userId    String   @db.Uuid
  branchId  String   @db.Uuid
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([userId, branchId])
  @@index([tenantId, userId])
  @@map("user_branch_access")
}

/// Tenant-defined custom roles with permission templates (extends static matrix).
model CustomRole {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  name        String   @db.VarChar(120)
  description String?  @db.Text
  permissions Json
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  assignments UserCustomRole[]

  @@unique([tenantId, name])
  @@index([tenantId, isArchived])
  @@map("custom_roles")
}

/// Assigns tenant custom roles to staff users.
model UserCustomRole {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  userId       String   @db.Uuid
  customRoleId String   @db.Uuid
  createdAt    DateTime @default(now())

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  customRole CustomRole @relation(fields: [customRoleId], references: [id], onDelete: Cascade)

  @@unique([userId, customRoleId])
  @@index([tenantId, userId])
  @@map("user_custom_roles")
}

/// Saved directory filter presets per admin user.
model UserSavedFilter {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  userId    String   @db.Uuid
  name      String   @db.VarChar(120)
  filters   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, name])
  @@index([tenantId, userId])
  @@map("user_saved_filters")
}

/// Staff working hours per day of week (identity module).
model StaffWeeklySchedule {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  userId    String   @db.Uuid
  dayOfWeek Int
  startHour Int      @default(9)
  startMin  Int      @default(0)
  endHour   Int      @default(17)
  endMin    Int      @default(0)
  isOff     Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, dayOfWeek])
  @@index([tenantId, userId])
  @@map("staff_weekly_schedules")
}

/// Staff user account. Patients also get a User record when they use the portal.
model User {
  id                  String    @id @default(uuid()) @db.Uuid
  tenantId            String    @db.Uuid
  branchId            String?   @db.Uuid
  email               String    @db.VarChar(255)
  /// bcryptjs hash — never returned in API responses
  passwordHash        String    @db.VarChar(255)
  firstName           String    @db.VarChar(100)
  lastName            String    @db.VarChar(100)
  firstNameAr         String?   @db.VarChar(100)
  lastNameAr          String?   @db.VarChar(100)
  phone               String?   @db.VarChar(30)
  jobTitle            String?   @db.VarChar(120)
  departmentId        String?   @db.Uuid
  managerId           String?   @db.Uuid
  startDate           DateTime? @db.Date
  employmentStatus    EmploymentStatus @default(ACTIVE)
  timezone            String?   @db.VarChar(64)
  languages           Json?
  avatarUrl           String?   @db.VarChar(512)
  notes               String?   @db.Text
  emergencyContactName  String? @db.VarChar(120)
  emergencyContactPhone String? @db.VarChar(30)
  branchAccessMode      BranchAccessMode @default(SINGLE)
  suspendedAt         DateTime?
  archivedAt          DateTime?
  isActive            Boolean   @default(true)
  /// Whether the user has verified their email address
  emailVerified       Boolean   @default(false)
  emailVerifiedAt     DateTime?
  /// TOTP MFA flag — secret stored AES-encrypted in mfaSecret
  mfaEnabled          Boolean   @default(false)
  mfaSecret           String?   @db.VarChar(88)
  /// Account locked until this datetime after repeated failures
  lockedUntil         DateTime?
  failedLoginCount    Int       @default(0)
  /// Track when password last changed to force re-auth on rotation
  passwordChangedAt   DateTime  @default(now())
  lastLoginAt         DateTime?
  lastLoginIp         String?   @db.VarChar(45)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  tenant                  Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  department              Department?              @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  branchAccess            UserBranchAccess[]
  customRoles             UserCustomRole[]
  regionAccess            UserRegionAccess[]
  savedFilters            UserSavedFilter[]
  weeklySchedule          StaffWeeklySchedule[]
  roles                   UserRoleAssignment[]
  refreshTokens           RefreshToken[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  mfaBackupCodes          MfaBackupCode[]
  trustedDevices          TrustedDevice[]
  dashboardLayouts        UserDashboardLayout[]

  /// Email must be unique per tenant (not globally)
  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([tenantId, isActive])
  @@index([tenantId, deletedAt])
  @@map("users")
}

/// Explicit role grant per user. Enables per-role auditing and future expiry.
/// Challenger note: array column would prevent per-role queries and index use.
model UserRoleAssignment {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  role      UserRole
  grantedBy String?   @db.Uuid
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([userId])
  @@map("user_role_assignments")
}

enum StaffInvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  CANCELLED
}

/// Pending staff onboarding invitations (email-based).
model StaffInvitation {
  id          String                @id @default(uuid()) @db.Uuid
  tenantId    String                @db.Uuid
  branchId    String?               @db.Uuid
  email       String                @db.VarChar(255)
  roles       Json
  firstName   String?               @db.VarChar(100)
  lastName    String?               @db.VarChar(100)
  firstNameAr String?               @db.VarChar(100)
  lastNameAr  String?               @db.VarChar(100)
  phone       String?               @db.VarChar(30)
  invitedBy   String                @db.Uuid
  status      StaffInvitationStatus @default(PENDING)
  expiresAt   DateTime
  acceptedAt  DateTime?
  userId      String?               @db.Uuid
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, status])
  @@index([tenantId, email])
  @@map("staff_invitations")
}

/// Per-user dashboard widget layout (hidden/order) keyed by role profile.
model UserDashboardLayout {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  userId    String   @db.Uuid
  profile   String   @db.VarChar(50)
  layout    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, profile])
  @@index([tenantId, userId])
  @@map("user_dashboard_layouts")
}

/// Hashed JWT refresh tokens for secure token rotation.
/// Each row = one device session. revokedAt is set on logout / rotation.
model RefreshToken {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  tenantId    String    @db.Uuid
  /// SHA-256 hash of the raw token — raw token is never stored
  tokenHash   String    @db.VarChar(64)
  /// Logical session identifier embedded in JWT claims for revocation
  sessionId   String    @unique @db.Uuid
  deviceName  String?   @db.VarChar(255)
  expiresAt   DateTime
  revokedAt   DateTime?
  ipAddress   String?   @db.VarChar(45)
  userAgent   String?   @db.Text
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tenantId])
  @@index([tokenHash])
  @@index([sessionId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// Immutable log of each login attempt for brute-force analysis.
/// Success=false rows drive account lockout policy.
model LoginAttempt {
  id          String   @id @default(uuid()) @db.Uuid
  email       String   @db.VarChar(255)
  tenantId    String?  @db.Uuid
  ipAddress   String   @db.VarChar(45)
  userAgent   String?  @db.Text
  success     Boolean
  failReason  String?  @db.VarChar(100)
  attemptedAt DateTime @default(now())

  @@index([email, attemptedAt])
  @@index([ipAddress, attemptedAt])
  @@index([tenantId, attemptedAt])
  @@map("login_attempts")
}

/// Short-lived tokens for password reset flow. One-time use.
model PasswordResetToken {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  tenantId    String    @db.Uuid
  /// SHA-256 of the raw token emailed to the user
  tokenHash   String    @db.VarChar(64)
  expiresAt   DateTime
  usedAt      DateTime?
  ipAddress   String?   @db.VarChar(45)
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tenantId])
  @@index([tokenHash])
  @@map("password_reset_tokens")
}

/// Short-lived tokens for email verification. One-time use.
model EmailVerificationToken {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  tenantId    String    @db.Uuid
  /// SHA-256 of the raw token emailed to the user
  tokenHash   String    @db.VarChar(64)
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tenantId])
  @@index([tokenHash])
  @@map("email_verification_tokens")
}

/// One-time MFA recovery codes (hashed). Generated when MFA is enabled.
model MfaBackupCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tenantId  String    @db.Uuid
  codeHash  String    @db.VarChar(64)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tenantId])
  @@index([codeHash])
  @@map("mfa_backup_codes")
}

/// Trusted browser/device tokens — skip MFA until expiry when presented at login.
model TrustedDevice {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tenantId   String    @db.Uuid
  tokenHash  String    @db.VarChar(64)
  deviceName String?   @db.VarChar(255)
  expiresAt  DateTime
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tenantId])
  @@index([tokenHash])
  @@map("trusted_devices")
}

// =============================================================================
// ── DOMAIN 2 · PATIENTS ──────────────────────────────────────────────────────
// =============================================================================

model Patient {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @db.Uuid
  branchId      String?   @db.Uuid
  firstName     String    @db.VarChar(100)
  lastName      String    @db.VarChar(100)
  firstNameAr   String?   @db.VarChar(100)
  lastNameAr    String?   @db.VarChar(100)
  dateOfBirth   DateTime? @db.Date
  /// 'male' | 'female' | 'other'
  gender        String?   @db.VarChar(10)
  phone         String?   @db.VarChar(30)
  email         String?   @db.VarChar(255)
  nationalId    String?   @db.VarChar(50)
  bloodGroup    String?   @db.VarChar(5)
  notes         String?   @db.Text
  /// Extended profile: emergency contacts, insurance, preferences, allergies (JSON)
  profileData   Json      @default("{}")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  addresses           PatientAddress[]
  appointments        Appointment[]
  encounters          Encounter[]
  invoices            Invoice[]
  commissions         CommissionCalculation[]
  dentalRecord        DentalRecord?
  beautyRecord        BeautyRecord?
  treatmentPlans      TreatmentPlan[]
  periodontalExams    PeriodontalExam[]
  orthodonticCases    OrthodonticCase[]
  implantRecords      ImplantRecord[]
  dentalClinicalNotes DentalClinicalNote[]
  loyaltyAccount      LoyaltyAccount?
  portalAccount       PortalAccount?
  queueTickets        QueueTicket[]
  waitlistEntries     AppointmentWaitlist[]
  clinicSubscriptions ClinicSubscription[]
  mediaAssets         MediaAsset[]
  problems            PatientProblem[]
  labResults          LabResult[]

  @@index([tenantId])
  @@index([tenantId, deletedAt])
  @@index([tenantId, phone])
  @@index([tenantId, nationalId])
  @@map("patients")
}

model PatientAddress {
  id          String    @id @default(uuid()) @db.Uuid
  patientId   String    @db.Uuid
  line1       String    @db.VarChar(255)
  line2       String?   @db.VarChar(255)
  city        String    @db.VarChar(100)
  state       String?   @db.VarChar(100)
  postalCode  String?   @db.VarChar(20)
  country     String    @default("SY") @db.VarChar(2)
  isPrimary   Boolean   @default(false)
  createdAt   DateTime  @default(now())

  patient     Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@map("patient_addresses")
}

// =============================================================================
// ── DOMAIN 3 · SCHEDULING ────────────────────────────────────────────────────
// =============================================================================

model Appointment {
  id              String              @id @default(uuid()) @db.Uuid
  tenantId        String              @db.Uuid
  branchId        String?             @db.Uuid
  patientId       String              @db.Uuid
  /// userId of the attending doctor/specialist
  providerId      String              @db.Uuid
  scheduledStart  DateTime
  scheduledEnd    DateTime
  status          AppointmentStatus   @default(PENDING)
  notes           String?             @db.Text
  cancellationReason String?          @db.VarChar(500)
  /// consultation, follow_up, procedure, imaging, lab, cleaning, etc.
  serviceType     String?             @db.VarChar(100)
  isEmergency     Boolean             @default(false)
  /// Groups recurring series appointments
  recurrenceSeriesId String?          @db.Uuid
  /// Room or equipment resource
  resourceId      String?             @db.Uuid
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  deletedAt       DateTime?

  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  patient         Patient             @relation(fields: [patientId], references: [id], onDelete: Restrict)
  encounters      Encounter[]
  queueTicket     QueueTicket?

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, patientId])
  @@index([tenantId, providerId])
  @@index([tenantId, scheduledStart])
  @@index([tenantId, recurrenceSeriesId])
  @@index([tenantId, resourceId])
  @@index([tenantId, deletedAt])
  @@map("appointments")
}

/// Patient waitlist when preferred slots are full.
model AppointmentWaitlist {
  id            String         @id @default(uuid()) @db.Uuid
  tenantId      String         @db.Uuid
  branchId      String?        @db.Uuid
  patientId     String         @db.Uuid
  providerId    String?        @db.Uuid
  preferredDate DateTime?
  durationMin   Int            @default(30)
  notes         String?        @db.Text
  status        WaitlistStatus @default(OPEN)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@index([tenantId, status])
  @@index([tenantId, patientId])
  @@map("appointment_waitlist")
}

/// Bookable rooms and equipment (chairs, imaging units, etc.).
model SchedulingResource {
  id           String                 @id @default(uuid()) @db.Uuid
  tenantId     String                 @db.Uuid
  branchId     String?                @db.Uuid
  name         String                 @db.VarChar(120)
  resourceType SchedulingResourceType
  isActive     Boolean                @default(true)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  deletedAt    DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  queueTickets QueueTicket[]

  @@index([tenantId, resourceType])
  @@index([tenantId, branchId])
  @@map("scheduling_resources")
}

/// Saved appointment presets for quick booking.
model AppointmentTemplate {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  branchId    String?  @db.Uuid
  name        String   @db.VarChar(120)
  serviceType String?  @db.VarChar(100)
  durationMin Int      @default(30)
  providerId  String?  @db.Uuid
  notes       String?  @db.Text
  isEmergency Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@map("appointment_templates")
}

/// Branch operating hours by day of week (0 = Sunday … 6 = Saturday).
model BranchOperatingHours {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  branchId  String   @db.Uuid
  dayOfWeek Int
  openHour  Int      @default(7)
  openMin   Int      @default(0)
  closeHour Int      @default(20)
  closeMin  Int      @default(0)
  isClosed  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([branchId, dayOfWeek])
  @@index([tenantId, branchId])
  @@map("branch_operating_hours")
}

/// Provider weekly availability (per tenant).
model ProviderWeeklySchedule {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  branchId   String?  @db.Uuid
  providerId String   @db.Uuid
  dayOfWeek  Int
  startHour  Int      @default(9)
  startMin   Int      @default(0)
  endHour    Int      @default(17)
  endMin     Int      @default(0)
  isOff      Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, providerId, dayOfWeek])
  @@index([tenantId, providerId])
  @@map("provider_weekly_schedules")
}

model AppointmentReminderLog {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  appointmentId String   @db.Uuid
  reminderType  String   @db.VarChar(20)
  sentAt        DateTime @default(now())

  @@unique([appointmentId, reminderType])
  @@index([tenantId, appointmentId])
  @@map("appointment_reminder_logs")
}

// =============================================================================
// ── DOMAIN 4 · EMR (Electronic Medical Records) ──────────────────────────────
// =============================================================================

enum EncounterStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  SIGNED

  @@map("encounter_status")
}

/// Clinical encounter record (the "visit" node on the patient timeline).
/// diagnoses, medications, observations are stored as JSONB because:
///   - They are always loaded together (no individual cross-encounter queries)
///   - Avoids 3 extra joins per encounter fetch
///   - Structure is validated in the domain layer before persistence
model Encounter {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @db.Uuid
  branchId        String?   @db.Uuid
  patientId       String    @db.Uuid
  appointmentId   String?   @db.Uuid
  /// userId of the attending clinician
  clinicianId     String    @db.Uuid
  chiefComplaint  String?   @db.Text
  /// DiagnosisVO[] — { code, system, description, severity }
  diagnoses       Json      @default("[]")
  /// MedicationVO[] — { name, dosage, frequency, duration }
  medications     Json      @default("[]")
  /// ObservationVO[] — { type, value, unit, recordedAt }
  observations    Json      @default("[]")
  /// Structured SOAP note sections
  soapNotes       Json      @default("{}")
  /// Typed clinical notes: { id, type, title?, body?, soap?, createdAt }
  structuredNotes Json      @default("[]")
  status          EncounterStatus @default(IN_PROGRESS)
  followUpDate    DateTime?
  completedAt     DateTime?
  signedAt        DateTime?
  signedBy        String?   @db.Uuid
  coSignedAt      DateTime?
  coSignedBy      String?   @db.Uuid
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  tenant          Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  patient         Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)
  appointment     Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  events          EncounterEvent[]

  @@index([tenantId])
  @@index([tenantId, patientId])
  @@index([tenantId, clinicianId])
  @@index([tenantId, createdAt])
  @@index([tenantId, deletedAt])
  @@index([tenantId, status])
  @@map("encounters")
}

/// Active/chronic problem list entry for a patient.
model PatientProblem {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @db.Uuid
  patientId     String    @db.Uuid
  code          String?   @db.VarChar(20)
  codingSystem  String?   @default("ICD-10") @db.VarChar(32)
  description   String    @db.VarChar(500)
  /// active | resolved
  status        String    @default("active") @db.VarChar(20)
  onsetDate     DateTime?
  resolvedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  patient       Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([tenantId, patientId])
  @@index([tenantId, status])
  @@map("patient_problems")
}

/// Immutable audit trail for encounter changes.
model EncounterEvent {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  encounterId   String   @db.Uuid
  action        String   @db.VarChar(64)
  actorUserId   String?  @db.Uuid
  metadata      Json?
  createdAt     DateTime @default(now())

  encounter     Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)

  @@index([tenantId, encounterId])
  @@index([tenantId, createdAt])
  @@map("encounter_events")
}

enum ClinicalNoteType {
  SOAP
  PROGRESS
  CONSULTATION
  PROCEDURE
  FOLLOW_UP

  @@map("clinical_note_type")
}

/// Tenant-configurable clinical note templates (SOAP or free-text).
model ClinicalNoteTemplate {
  id        String           @id @default(uuid()) @db.Uuid
  tenantId  String           @db.Uuid
  name      String           @db.VarChar(200)
  noteType  ClinicalNoteType @default(CONSULTATION)
  soapNotes Json             @default("{}")
  body      String?          @db.Text
  isActive  Boolean          @default(true)
  sortOrder Int              @default(0)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, isActive])
  @@map("clinical_note_templates")
}

/// Laboratory test results linked to a patient (optionally to an encounter).
model LabResult {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @db.Uuid
  patientId      String    @db.Uuid
  encounterId    String?   @db.Uuid
  testName       String    @db.VarChar(200)
  value          String    @db.VarChar(100)
  unit           String?   @db.VarChar(50)
  referenceRange String?   @db.VarChar(100)
  /// normal | abnormal | critical
  status         String?   @db.VarChar(30)
  resultedAt     DateTime
  notes          String?   @db.Text
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  patient        Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([tenantId, patientId])
  @@index([tenantId, encounterId])
  @@map("lab_results")
}

// =============================================================================
// ── DOMAIN 5 · DENTAL ────────────────────────────────────────────────────────
// =============================================================================

enum OdontogramMode {
  ADULT
  PEDIATRIC

  @@map("odontogram_mode")
}

enum OrthodonticCaseStatus {
  ACTIVE
  RETENTION
  COMPLETED
  CANCELLED

  @@map("orthodontic_case_status")
}

enum ImplantRecordStatus {
  PLANNED
  PLACED
  RESTORED
  FAILED

  @@map("implant_record_status")
}

/// One record per patient — aggregate root for the interactive odontogram.
/// odontogramState: JSONB snapshot of all 32 teeth current condition states.
/// Individual condition log entries are in DentalToothCondition.
model DentalRecord {
  id               String                 @id @default(uuid()) @db.Uuid
  tenantId         String                 @db.Uuid
  patientId        String                 @unique @db.Uuid
  odontogramMode   OdontogramMode         @default(ADULT)
  /// Full odontogram snapshot: { teeth: [...], procedures: [...] }
  odontogramState  Json                   @default("{}")
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  patient          Patient                @relation(fields: [patientId], references: [id], onDelete: Cascade)
  toothConditions  DentalToothCondition[]
  clinicalNotes    DentalClinicalNote[]

  @@index([tenantId])
  @@map("dental_records")
}

/// Orthodontic treatment case — appliance tracking, wire changes, retention.
model OrthodonticCase {
  id               String                @id @default(uuid()) @db.Uuid
  tenantId         String                @db.Uuid
  patientId        String                @db.Uuid
  status           OrthodonticCaseStatus @default(ACTIVE)
  applianceType    String                @db.VarChar(50)
  startDate        DateTime?
  estimatedEndDate DateTime?
  notes            String?               @db.Text
  /// JSON: wireChanges[], elastics[], ipr[], alignerTrays, progressNotes
  clinicalData     Json                  @default("{}")
  createdBy        String                @db.Uuid
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([tenantId, patientId])
  @@index([tenantId, status])
  @@map("orthodontic_cases")
}

/// Implant placement and restoration tracking per tooth site.
model ImplantRecord {
  id              String              @id @default(uuid()) @db.Uuid
  tenantId        String              @db.Uuid
  patientId       String              @db.Uuid
  /// FDI notation e.g. "11"
  toothId         String              @db.VarChar(4)
  implantSystem   String?             @db.VarChar(100)
  implantDiameter Decimal?            @db.Decimal(5, 2)
  implantLength   Decimal?            @db.Decimal(5, 2)
  abutmentType    String?             @db.VarChar(100)
  status          ImplantRecordStatus @default(PLANNED)
  placedAt        DateTime?
  restoredAt      DateTime?
  notes           String?             @db.Text
  /// JSON: boneGraft, sinusLift, torque, healingCap, complications
  surgicalData    Json                @default("{}")
  createdBy       String              @db.Uuid
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([tenantId, patientId])
  @@index([tenantId, toothId])
  @@index([tenantId, status])
  @@map("implant_records")
}

/// Dental-specific clinical notes (progress, referral, consent documentation).
model DentalClinicalNote {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  patientId      String   @db.Uuid
  dentalRecordId String?  @db.Uuid
  encounterId    String?  @db.Uuid
  /// progress | referral | consent | general
  noteType       String   @default("progress") @db.VarChar(30)
  content        String   @db.Text
  authorId       String   @db.Uuid
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  patient      Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  dentalRecord DentalRecord? @relation(fields: [dentalRecordId], references: [id], onDelete: SetNull)

  @@index([tenantId, patientId])
  @@index([tenantId, createdAt])
  @@map("dental_clinical_notes")
}

/// Immutable log entry per tooth condition event (caries, RCT, extraction, etc.)
model DentalToothCondition {
  id             String       @id @default(uuid()) @db.Uuid
  dentalRecordId String       @db.Uuid
  tenantId       String       @db.Uuid
  /// FDI two-digit notation: "11"–"48"
  toothId        String       @db.VarChar(4)
  /// e.g. "mesial" | "distal" | "occlusal" | "buccal" | "lingual"
  surface        String?      @db.VarChar(20)
  /// e.g. "caries" | "root_canal" | "extraction" | "implant" | "crown"
  conditionCode  String       @db.VarChar(50)
  notes          String?      @db.Text
  encounterId    String?      @db.Uuid
  recordedBy     String       @db.Uuid
  recordedAt     DateTime     @default(now())

  dentalRecord   DentalRecord @relation(fields: [dentalRecordId], references: [id], onDelete: Cascade)

  @@index([dentalRecordId])
  @@index([tenantId, toothId])
  @@index([tenantId, conditionCode])
  @@map("dental_tooth_conditions")
}

/// Maps ADA/CDT procedure codes to default inventory consumables (composite, crown kit, implant, etc.).
model DentalProcedureMaterial {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @db.Uuid
  procedureCode   String   @db.VarChar(30)
  inventoryItemId String   @db.Uuid
  defaultQuantity Decimal  @default(1) @db.Decimal(18, 4)
  notes           String?  @db.Text
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  @@unique([tenantId, procedureCode, inventoryItemId])
  @@index([tenantId])
  @@index([tenantId, procedureCode])
  @@map("dental_procedure_materials")
}

/// Maps beauty treatment types (botox, filler, etc.) to default inventory consumables.
model BeautyProcedureMaterial {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @db.Uuid
  procedureCode   String   @db.VarChar(30)
  inventoryItemId String   @db.Uuid
  defaultQuantity Decimal  @default(1) @db.Decimal(18, 4)
  notes           String?  @db.Text
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  @@unique([tenantId, procedureCode, inventoryItemId])
  @@index([tenantId])
  @@index([tenantId, procedureCode])
  @@map("beauty_procedure_materials")
}

enum TreatmentPlanStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TreatmentPlanItemStatus {
  PLANNED
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  BLOCKED
}

/// Multi-visit treatment plan with phases, sequencing, cost, and approval workflow.
model TreatmentPlan {
  id                    String              @id @default(uuid()) @db.Uuid
  tenantId              String              @db.Uuid
  patientId             String              @db.Uuid
  title                 String              @db.VarChar(200)
  status                TreatmentPlanStatus @default(DRAFT)
  clinicalNotes         String?             @db.Text
  totalEstimatedCost    Decimal?            @db.Decimal(12, 2)
  totalEstimatedMinutes Int                 @default(0)
  currency              String              @default("USD") @db.VarChar(3)
  consentSignedAt       DateTime?
  consentRecordedBy     String?             @db.Uuid
  consentMethod         String?             @db.VarChar(50)
  approvedAt            DateTime?
  approvedBy            String?             @db.Uuid
  submittedAt           DateTime?
  submittedBy             String?             @db.Uuid
  /// Insurance-ready snapshot: provider, memberId, groupNumber, planType, coveragePercent
  insuranceSnapshot     Json                @default("{}")
  createdBy             String              @db.Uuid
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  patient Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  phases  TreatmentPhase[]

  @@index([tenantId, patientId])
  @@index([tenantId, status])
  @@map("treatment_plans")
}

/// Treatment phase grouping procedures across one or more visits.
model TreatmentPhase {
  id                 String    @id @default(uuid()) @db.Uuid
  planId             String    @db.Uuid
  tenantId           String    @db.Uuid
  name               String    @db.VarChar(120)
  sortOrder          Int       @default(0)
  visitNumber        Int?
  estimatedVisitDate DateTime?
  clinicalNotes      String?   @db.Text

  plan  TreatmentPlan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  items TreatmentPlanItem[]

  @@index([planId])
  @@map("treatment_phases")
}

/// Individual planned procedure with sequencing, cost, and progress tracking.
model TreatmentPlanItem {
  id                String                  @id @default(uuid()) @db.Uuid
  phaseId           String                  @db.Uuid
  tenantId          String                  @db.Uuid
  sortOrder         Int                     @default(0)
  code              String                  @db.VarChar(20)
  description       String                  @db.VarChar(500)
  toothNumbers      Json                    @default("[]")
  status            TreatmentPlanItemStatus @default(PLANNED)
  estimatedMinutes  Int                     @default(30)
  estimatedCost     Decimal                 @default(0) @db.Decimal(12, 2)
  dependsOnItemId   String?                 @db.Uuid
  completedAt       DateTime?
  completedBy       String?                 @db.Uuid
  encounterId       String?                 @db.Uuid
  insuranceEligible Boolean                 @default(true)
  insuranceEstimate Decimal?                @db.Decimal(12, 2)
  patientPortion    Decimal?                @db.Decimal(12, 2)
  requiresPreAuth   Boolean                 @default(false)
  preAuthStatus     String?                 @db.VarChar(30)

  phase      TreatmentPhase     @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  dependsOn  TreatmentPlanItem? @relation("PlanItemDependency", fields: [dependsOnItemId], references: [id], onDelete: SetNull)
  dependents TreatmentPlanItem[] @relation("PlanItemDependency")

  @@index([phaseId])
  @@index([tenantId, status])
  @@map("treatment_plan_items")
}

/// Periodontal charting exam — full-mouth probing with historical snapshots.
model PeriodontalExam {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  patientId  String   @db.Uuid
  recordedBy String   @db.Uuid
  examDate   DateTime @default(now())
  notes      String?  @db.Text
  /// { teeth: Record<string, PerioTooth>, summary: PerioSummary }
  chartData  Json     @default("{}")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([tenantId, patientId])
  @@index([tenantId, patientId, examDate])
  @@map("periodontal_exams")
}

// =============================================================================
// ── DOMAIN 6 · BEAUTY / AESTHETICS ───────────────────────────────────────────
// =============================================================================

/// One record per patient — aggregate root for the interactive body/face map.
model BeautyRecord {
  id            String             @id @default(uuid()) @db.Uuid
  tenantId      String             @db.Uuid
  patientId     String             @unique @db.Uuid
  /// Full anatomy map snapshot state
  bodyMapState  Json               @default("{}")
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  patient       Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  annotations   BeautyAnnotation[]

  @@index([tenantId])
  @@map("beauty_records")
}

/// Immutable log of a pinned injection/treatment on the anatomy map.
model BeautyAnnotation {
  id             String       @id @default(uuid()) @db.Uuid
  beautyRecordId String       @db.Uuid
  tenantId       String       @db.Uuid
  /// Anatomical zone label, e.g. "forehead", "nasolabial_fold"
  zone           String       @db.VarChar(100)
  /// e.g. "botox" | "filler" | "laser" | "prp"
  treatment      String       @db.VarChar(100)
  /// { x: Float, y: Float, view: 'front'|'back'|'left'|'right' }
  coordinates    Json
  /// { volumeCc: Float, joulesUsed: Float, skinDepthMm: Float, machine: String }
  parameters     Json         @default("{}")
  encounterId    String?      @db.Uuid
  recordedBy     String       @db.Uuid
  recordedAt     DateTime     @default(now())
  notes          String?      @db.Text

  beautyRecord   BeautyRecord @relation(fields: [beautyRecordId], references: [id], onDelete: Cascade)

  @@index([beautyRecordId])
  @@index([tenantId, recordedAt])
  @@map("beauty_annotations")
}

// =============================================================================
// ── DOMAIN 7 · INVENTORY ─────────────────────────────────────────────────────
// =============================================================================

model InventoryCategory {
  id        String          @id @default(uuid()) @db.Uuid
  tenantId  String          @db.Uuid
  key       String          @db.VarChar(50)
  nameEn    String          @db.VarChar(100)
  nameAr    String?         @db.VarChar(100)
  sortOrder Int             @default(0)
  isSystem  Boolean         @default(false)
  createdAt DateTime        @default(now())

  items     InventoryItem[]

  @@unique([tenantId, key])
  @@index([tenantId])
  @@map("inventory_categories")
}

model InventorySupplier {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @db.Uuid
  code         String    @db.VarChar(50)
  nameEn       String    @db.VarChar(255)
  nameAr       String?   @db.VarChar(255)
  contactName  String?   @db.VarChar(255)
  email        String?   @db.VarChar(255)
  phone        String?   @db.VarChar(50)
  address      String?   @db.VarChar(500)
  leadTimeDays Int?
  notes        String?   @db.Text
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  items        InventoryItem[]
  purchaseOrders PurchaseOrder[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, deletedAt])
  @@map("inventory_suppliers")
}

model InventoryItem {
  id                String                   @id @default(uuid()) @db.Uuid
  tenantId          String                   @db.Uuid
  branchId          String?                  @db.Uuid
  categoryId        String?                  @db.Uuid
  sku               String                   @db.VarChar(100)
  barcode           String?                  @db.VarChar(100)
  brand             String?                  @db.VarChar(100)
  nameEn            String                   @db.VarChar(255)
  nameAr            String?                  @db.VarChar(255)
  unit              String                   @db.VarChar(30)
  quantityOnHand    Decimal                  @default(0) @db.Decimal(18, 4)
  reorderThreshold  Decimal                  @default(0) @db.Decimal(18, 4)
  minQuantity       Decimal?                 @db.Decimal(18, 4)
  maxQuantity       Decimal?                 @db.Decimal(18, 4)
  costPerUnit       Decimal?                 @db.Decimal(18, 4)
  sellingPrice      Decimal?                 @db.Decimal(18, 4)
  storageLocation   String?                  @db.VarChar(255)
  expiryDate        DateTime?                @db.Date
  supplierId        String?                  @db.Uuid
  lotNumber         String?                  @db.VarChar(100)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  deletedAt         DateTime?

  tenant            Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  category          InventoryCategory?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  supplier          InventorySupplier?       @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  consumptionLogs   InventoryConsumptionLog[]
  stockMovements    InventoryStockMovement[]
  batches           InventoryBatch[]
  disposalLogs      InventoryDisposalLog[]
  purchaseOrderLines PurchaseOrderLine[]
  warehouseStock     InventoryWarehouseStock[]
  stockTransferLines InventoryStockTransferLine[]
  stockCountLines    InventoryStockCountLine[]
  stockRequestLines  InventoryStockRequestLine[]
  procedureMaterials DentalProcedureMaterial[]
  beautyProcedureMaterials BeautyProcedureMaterial[]

  @@unique([tenantId, sku])
  @@index([tenantId])
  @@index([tenantId, deletedAt])
  @@index([tenantId, categoryId])
  @@index([tenantId, barcode])
  @@index([tenantId, supplierId])
  @@index([tenantId, expiryDate])
  /// Partial index on low-stock items — used by reorder alerts
  @@index([tenantId, quantityOnHand])
  @@index([tenantId, deletedAt, nameEn])
  @@map("inventory_items")
}

/// Immutable consumption event — triggered automatically on treatment completion.
model InventoryConsumptionLog {
  id              String        @id @default(uuid()) @db.Uuid
  tenantId        String        @db.Uuid
  inventoryItemId String        @db.Uuid
  encounterId     String?       @db.Uuid
  patientId       String?       @db.Uuid
  procedureCode   String?       @db.VarChar(30)
  quantityUsed    Decimal       @db.Decimal(18, 4)
  /// userId of staff who triggered the consumption
  consumedBy      String        @db.Uuid
  notes           String?       @db.Text
  consumedAt      DateTime      @default(now())
  invoiceId       String?       @db.Uuid
  invoiceLineItemId String?     @db.Uuid

  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  invoice         Invoice?      @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  invoiceLineItem InvoiceLineItem? @relation(fields: [invoiceLineItemId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([inventoryItemId])
  @@index([tenantId, consumedAt])
  @@index([tenantId, patientId])
  @@index([tenantId, invoiceId])
  @@map("inventory_consumption_logs")
}

/// Immutable stock movement ledger — all quantity changes (receive, consume, adjust, initial).
model InventoryStockMovement {
  id              String        @id @default(uuid()) @db.Uuid
  tenantId        String        @db.Uuid
  inventoryItemId String        @db.Uuid
  /// INITIAL | RECEIVE | CONSUME | ADJUST
  movementType    String        @db.VarChar(30)
  quantity        Decimal       @db.Decimal(18, 4)
  quantityBefore  Decimal       @db.Decimal(18, 4)
  quantityAfter   Decimal       @db.Decimal(18, 4)
  reason          String?       @db.VarChar(255)
  notes           String?       @db.Text
  encounterId     String?       @db.Uuid
  patientId       String?       @db.Uuid
  procedureCode   String?       @db.VarChar(30)
  warehouseId     String?       @db.Uuid
  performedBy     String        @db.Uuid
  createdAt       DateTime      @default(now())

  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([inventoryItemId])
  @@index([tenantId, createdAt])
  @@index([tenantId, movementType])
  @@index([tenantId, warehouseId])
  @@map("inventory_stock_movements")
}

/// Per-receipt batch/lot tracking with independent expiry and quantity.
model InventoryBatch {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @db.Uuid
  inventoryItemId  String    @db.Uuid
  lotNumber        String?   @db.VarChar(100)
  manufacturedDate DateTime? @db.Date
  expiryDate       DateTime? @db.Date
  quantityOnHand   Decimal   @default(0) @db.Decimal(18, 4)
  /// ACTIVE | DEPLETED | DISPOSED
  status           String    @default("ACTIVE") @db.VarChar(20)
  receivedAt       DateTime  @default(now())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  inventoryItem    InventoryItem          @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  disposalLogs     InventoryDisposalLog[]

  @@index([tenantId])
  @@index([inventoryItemId])
  @@index([tenantId, expiryDate])
  @@index([tenantId, status])
  @@map("inventory_batches")
}

/// Immutable disposal record for expired or damaged stock.
model InventoryDisposalLog {
  id              String          @id @default(uuid()) @db.Uuid
  tenantId        String          @db.Uuid
  inventoryItemId String          @db.Uuid
  batchId         String?         @db.Uuid
  quantity        Decimal         @db.Decimal(18, 4)
  reason          String          @db.VarChar(255)
  notes           String?         @db.Text
  disposedBy      String          @db.Uuid
  disposedAt      DateTime        @default(now())

  inventoryItem   InventoryItem   @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  batch           InventoryBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([inventoryItemId])
  @@index([batchId])
  @@index([tenantId, disposedAt])
  @@map("inventory_disposal_logs")
}

/// Purchase order header — procurement workflow from draft through goods receipt.
model PurchaseOrder {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  poNumber    String    @db.VarChar(30)
  supplierId  String?   @db.Uuid
  /// DRAFT | PENDING_APPROVAL | APPROVED | PARTIALLY_RECEIVED | RECEIVED | CANCELLED
  status      String    @default("DRAFT") @db.VarChar(30)
  notes       String?   @db.Text
  requestedBy String    @db.Uuid
  approvedBy  String?   @db.Uuid
  approvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant   Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  supplier InventorySupplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  lines    PurchaseOrderLine[]

  @@unique([tenantId, poNumber])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, supplierId])
  @@map("purchase_orders")
}

/// Line item on a purchase order — tracks ordered vs received quantity.
model PurchaseOrderLine {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @db.Uuid
  purchaseOrderId  String   @db.Uuid
  inventoryItemId  String   @db.Uuid
  quantityOrdered  Decimal  @db.Decimal(18, 4)
  quantityReceived Decimal  @default(0) @db.Decimal(18, 4)
  unitCost         Decimal? @db.Decimal(18, 4)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  @@index([purchaseOrderId])
  @@index([tenantId])
  @@index([inventoryItemId])
  @@map("purchase_order_lines")
}

/// Storage location within a tenant — clinic store, central warehouse, pharmacy room, etc.
model InventoryWarehouse {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  branchId  String?   @db.Uuid
  code      String    @db.VarChar(50)
  nameEn    String    @db.VarChar(255)
  nameAr    String?   @db.VarChar(255)
  address   String?   @db.VarChar(500)
  isDefault Boolean   @default(false)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant         Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  stockLevels    InventoryWarehouseStock[]
  stockCounts    InventoryStockCount[]
  stockRequests  InventoryStockRequest[]
  transfersFrom  InventoryStockTransfer[]  @relation("TransferFromWarehouse")
  transfersTo    InventoryStockTransfer[]  @relation("TransferToWarehouse")

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, deletedAt])
  @@index([tenantId, isDefault])
  @@map("inventory_warehouses")
}

/// Per-location stock quantity — item totals are the sum across warehouses.
model InventoryWarehouseStock {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @db.Uuid
  warehouseId     String   @db.Uuid
  inventoryItemId String   @db.Uuid
  quantityOnHand  Decimal  @default(0) @db.Decimal(18, 4)
  updatedAt       DateTime @updatedAt

  warehouse     InventoryWarehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  inventoryItem InventoryItem      @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  @@unique([tenantId, warehouseId, inventoryItemId])
  @@index([tenantId])
  @@index([warehouseId])
  @@index([inventoryItemId])
  @@map("inventory_warehouse_stock")
}

/// Inter-location stock transfer — ship from source, receive at destination.
model InventoryStockTransfer {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @db.Uuid
  transferNumber  String    @db.VarChar(30)
  fromWarehouseId String    @db.Uuid
  toWarehouseId   String    @db.Uuid
  /// DRAFT | IN_TRANSIT | RECEIVED | CANCELLED
  status          String    @default("DRAFT") @db.VarChar(30)
  notes           String?   @db.Text
  requestedBy     String    @db.Uuid
  shippedAt       DateTime?
  receivedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  fromWarehouse InventoryWarehouse         @relation("TransferFromWarehouse", fields: [fromWarehouseId], references: [id], onDelete: Restrict)
  toWarehouse   InventoryWarehouse         @relation("TransferToWarehouse", fields: [toWarehouseId], references: [id], onDelete: Restrict)
  lines         InventoryStockTransferLine[]

  @@unique([tenantId, transferNumber])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([fromWarehouseId])
  @@index([toWarehouseId])
  @@map("inventory_stock_transfers")
}

model InventoryStockTransferLine {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @db.Uuid
  stockTransferId  String   @db.Uuid
  inventoryItemId  String   @db.Uuid
  quantity         Decimal  @db.Decimal(18, 4)
  quantityReceived Decimal  @default(0) @db.Decimal(18, 4)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  stockTransfer InventoryStockTransfer @relation(fields: [stockTransferId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem          @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  @@index([stockTransferId])
  @@index([tenantId])
  @@index([inventoryItemId])
  @@map("inventory_stock_transfer_lines")
}

/// Physical stock count / cycle count at a warehouse location.
model InventoryStockCount {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  countNumber String    @db.VarChar(30)
  warehouseId String    @db.Uuid
  /// DRAFT | IN_PROGRESS | PENDING_APPROVAL | APPROVED | CANCELLED
  status      String    @default("DRAFT") @db.VarChar(30)
  notes       String?   @db.Text
  requestedBy String    @db.Uuid
  approvedBy  String?   @db.Uuid
  approvedAt  DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  warehouse InventoryWarehouse         @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  lines     InventoryStockCountLine[]

  @@unique([tenantId, countNumber])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([warehouseId])
  @@map("inventory_stock_counts")
}

model InventoryStockCountLine {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @db.Uuid
  stockCountId    String   @db.Uuid
  inventoryItemId String   @db.Uuid
  systemQuantity  Decimal  @db.Decimal(18, 4)
  countedQuantity Decimal? @db.Decimal(18, 4)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  stockCount    InventoryStockCount @relation(fields: [stockCountId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem       @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  @@index([stockCountId])
  @@index([tenantId])
  @@index([inventoryItemId])
  @@map("inventory_stock_count_lines")
}

/// Internal stock requisition from a department or clinician.
model InventoryStockRequest {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @db.Uuid
  requestNumber  String    @db.VarChar(30)
  /// DEPARTMENT | CLINICAL
  requestType    String    @default("DEPARTMENT") @db.VarChar(20)
  /// DRAFT | SUBMITTED | APPROVED | FULFILLED | REJECTED | CANCELLED
  status         String    @default("DRAFT") @db.VarChar(30)
  departmentName String?   @db.VarChar(120)
  patientId      String?   @db.Uuid
  warehouseId    String?   @db.Uuid
  notes          String?   @db.Text
  requestedBy    String    @db.Uuid
  approvedBy     String?   @db.Uuid
  approvedAt     DateTime?
  rejectedBy     String?   @db.Uuid
  rejectedAt     DateTime?
  rejectionReason String?  @db.Text
  fulfilledBy    String?   @db.Uuid
  fulfilledAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  warehouse InventoryWarehouse?         @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  lines     InventoryStockRequestLine[]

  @@unique([tenantId, requestNumber])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, requestedBy])
  @@map("inventory_stock_requests")
}

model InventoryStockRequestLine {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @db.Uuid
  stockRequestId    String   @db.Uuid
  inventoryItemId   String   @db.Uuid
  quantityRequested Decimal  @db.Decimal(18, 4)
  quantityFulfilled Decimal  @default(0) @db.Decimal(18, 4)
  notes             String?  @db.Text
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  stockRequest  InventoryStockRequest @relation(fields: [stockRequestId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem         @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  @@index([stockRequestId])
  @@index([tenantId])
  @@index([inventoryItemId])
  @@map("inventory_stock_request_lines")
}

// =============================================================================
// ── DOMAIN 8 · QUEUE (Smart Waiting Room) ────────────────────────────────────
// =============================================================================

/// One ticket per appointment — driven by WebSocket gateway for live TV view.
model QueueTicket {
  id              String             @id @default(uuid()) @db.Uuid
  tenantId        String             @db.Uuid
  branchId        String?            @db.Uuid
  appointmentId   String             @unique @db.Uuid
  patientId       String             @db.Uuid
  providerId      String             @db.Uuid
  scheduledStart  DateTime
  scheduledEnd    DateTime
  status          QueueTicketStatus  @default(WAITING)
  priority        QueuePriority      @default(NORMAL)
  /// Manual queue order within the same priority band (lower = earlier)
  sortOrder       Int                @default(0)
  checkedInAt     DateTime?
  calledAt        DateTime?
  servedAt        DateTime?
  completedAt     DateTime?
  /// Computed wait time in seconds for analytics
  waitTimeSeconds Int?
  /// Assigned room / chair / equipment
  resourceId      String?            @db.Uuid
  /// Estimated ready time for waiting patients
  etaAt           DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  patient         Patient            @relation(fields: [patientId], references: [id], onDelete: Restrict)
  appointment     Appointment        @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  resource        SchedulingResource? @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  events          QueueTicketEvent[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, scheduledStart])
  @@index([tenantId, providerId])
  @@map("queue_tickets")
}

/// Immutable audit trail for queue operations.
model QueueTicketEvent {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  queueTicketId String   @db.Uuid
  action        String   @db.VarChar(64)
  fromStatus    String?  @db.VarChar(32)
  toStatus      String?  @db.VarChar(32)
  actorUserId   String?  @db.Uuid
  metadata      Json?
  createdAt     DateTime @default(now())

  queueTicket   QueueTicket @relation(fields: [queueTicketId], references: [id], onDelete: Cascade)

  @@index([tenantId, queueTicketId])
  @@index([tenantId, createdAt])
  @@map("queue_ticket_events")
}

// =============================================================================
// ── DOMAIN 9 · BILLING ───────────────────────────────────────────────────────
// =============================================================================

model Invoice {
  id             String        @id @default(uuid()) @db.Uuid
  tenantId       String        @db.Uuid
  branchId       String?       @db.Uuid
  patientId      String        @db.Uuid
  invoiceNumber  String        @db.VarChar(50)
  invoiceDate    DateTime      @db.Date
  dueDate        DateTime?     @db.Date
  /// ISO 4217 code, default SYP (Syrian Pound)
  currency       String        @default("SYP") @db.VarChar(3)
  status         InvoiceStatus @default(DRAFT)
  amountSubtotal Decimal       @default(0) @db.Decimal(18, 4)
  amountDiscount Decimal       @default(0) @db.Decimal(18, 4)
  amountTax      Decimal       @default(0) @db.Decimal(18, 4)
  amountTotal    Decimal       @default(0) @db.Decimal(18, 4)
  amountPaid     Decimal       @default(0) @db.Decimal(18, 4)
  /// Insurance payer allocation (patient portion = amountTotal - insuranceAmount when set)
  insuranceProvider       String?  @db.VarChar(255)
  insurancePolicyNumber   String?  @db.VarChar(100)
  insuranceAmount         Decimal  @default(0) @db.Decimal(18, 4)
  patientResponsibility   Decimal  @default(0) @db.Decimal(18, 4)
  insuranceClaimStatus    String?  @db.VarChar(50)
  notes          String?       @db.Text
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  patient        Patient       @relation(fields: [patientId], references: [id], onDelete: Restrict)
  lineItems      InvoiceLineItem[]
  payments       InvoicePayment[]
  refunds        InvoiceRefund[]
  creditNotes    CreditNote[]
  writeOffs      InvoiceWriteOff[]
  paymentPlans   PaymentPlan[]
  receipts       PaymentReceipt[]
  consumptionLogs InventoryConsumptionLog[]

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, patientId])
  @@index([tenantId, invoiceDate])
  @@index([tenantId, dueDate])
  @@index([tenantId, deletedAt])
  @@map("invoices")
}

model InvoiceLineItem {
  id              String   @id @default(uuid()) @db.Uuid
  invoiceId       String   @db.Uuid
  tenantId        String   @db.Uuid
  description     String   @db.VarChar(500)
  quantity        Decimal  @db.Decimal(18, 4)
  unitPrice       Decimal  @db.Decimal(18, 4)
  discountPercent Decimal  @default(0) @db.Decimal(5, 2)
  taxPercent      Decimal  @default(0) @db.Decimal(5, 2)
  subtotal        Decimal  @db.Decimal(18, 4)
  discountAmount  Decimal  @db.Decimal(18, 4)
  taxAmount       Decimal  @db.Decimal(18, 4)
  lineTotal       Decimal  @db.Decimal(18, 4)
  /// Optional service classification code for commission rule matching
  serviceCode     String?  @db.VarChar(50)
  encounterId     String?  @db.Uuid
  createdAt       DateTime @default(now())

  invoice         Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  consumptionLogs InventoryConsumptionLog[]

  @@index([invoiceId])
  @@index([tenantId])
  @@map("invoice_line_items")
}

model InvoicePayment {
  id               String   @id @default(uuid()) @db.Uuid
  invoiceId        String   @db.Uuid
  tenantId         String   @db.Uuid
  amount           Decimal  @db.Decimal(18, 4)
  /// e.g. "cash" | "card" | "syriatel_cash" | "bank_transfer"
  paymentMethod    String   @db.VarChar(50)
  paymentReference String?  @db.VarChar(255)
  paymentDate      DateTime @db.Date
  recordedBy       String   @db.Uuid
  notes            String?  @db.Text
  createdAt        DateTime @default(now())

  invoice          Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  refunds          InvoiceRefund[]

  @@index([invoiceId])
  @@index([tenantId])
  @@index([tenantId, paymentDate])
  @@map("invoice_payments")
}

model TenantBillingSequence {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  prefix       String   @default("INV") @db.VarChar(20)
  lastNumber   Int      @default(0)
  updatedAt    DateTime @updatedAt

  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, prefix])
  @@map("tenant_billing_sequences")
}

model InvoiceRefund {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @db.Uuid
  invoiceId       String   @db.Uuid
  paymentId       String?  @db.Uuid
  amount          Decimal  @db.Decimal(18, 4)
  reason          String   @db.VarChar(500)
  refundMethod    String   @db.VarChar(50)
  refundReference String?  @db.VarChar(255)
  refundDate      DateTime @db.Date
  approvedBy      String   @db.Uuid
  notes           String?  @db.Text
  createdAt       DateTime @default(now())

  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  invoice         Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  payment         InvoicePayment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([invoiceId])
  @@map("invoice_refunds")
}

model CreditNote {
  id              String           @id @default(uuid()) @db.Uuid
  tenantId        String           @db.Uuid
  invoiceId       String           @db.Uuid
  creditNoteNumber String          @db.VarChar(50)
  status          CreditNoteStatus @default(DRAFT)
  amount          Decimal          @db.Decimal(18, 4)
  reason          String           @db.VarChar(500)
  issuedAt        DateTime?
  appliedAt       DateTime?
  issuedBy        String?          @db.Uuid
  notes           String?          @db.Text
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  invoice         Invoice          @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([tenantId, creditNoteNumber])
  @@index([tenantId])
  @@index([invoiceId])
  @@map("credit_notes")
}

model InvoiceWriteOff {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  invoiceId   String   @db.Uuid
  amount      Decimal  @db.Decimal(18, 4)
  reason      String   @db.VarChar(500)
  approvedBy  String   @db.Uuid
