  createdAt     DateTime  @default(now())

  plan          PaymentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, sequence])
  @@index([tenantId])
  @@index([planId])
  @@map("payment_plan_installments")
}

model ServicePrice {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  serviceCode   String   @db.VarChar(50)
  nameEn        String   @db.VarChar(255)
  nameAr        String?  @db.VarChar(255)
