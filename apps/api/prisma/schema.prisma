  keyHash              String    @db.VarChar(64)
  hashAlgorithm        String    @default("sha256_pepper_v1") @db.VarChar(40)
  status               String    @default("active") @db.VarChar(40)
  scopes               Json      @default("[]")
  ownerType            String    @db.VarChar(40)
