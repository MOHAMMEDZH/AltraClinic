// =============================================================================
// ── DOMAIN 16 · AUDIT (APPEND-ONLY) ─────────────────────────────────────────
// =============================================================================

/// Immutable audit trail. No updated_at — a trigger blocks UPDATE and DELETE.
/// Challenger note: BRIN index on created_at appropriate for time-range analytics
/// when table partitioning is introduced in production.
model AuditEntry {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @db.Uuid
  branchId      String?   @db.Uuid
  action        String    @db.VarChar(100)
  resourceType  String    @db.VarChar(100)
  resourceId    String    @db.Uuid
  actorId       String    @db.Uuid
  actorRoles    String[]
  category      String?   @db.VarChar(50)
  descriptionEn String?   @db.Text
  descriptionAr String?   @db.Text
  reason        String?   @db.Text
  /// Diff snapshot: Record<string, { before: string|null, after: string|null }>
  changes       Json?
  /// Extra context: Record<string, string>
  details       Json?
  ipAddress     String?   @db.VarChar(45)
  userAgent     String?   @db.Text
  correlationId String?   @db.Uuid
  locale        String?   @db.VarChar(5)
  createdAt     DateTime  @default(now())

  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([tenantId, resourceType, resourceId])
  @@index([tenantId, actorId])
  @@index([tenantId, createdAt])
  @@index([correlationId])
  @@map("audit_entries")
}

