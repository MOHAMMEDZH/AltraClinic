  assignedAt          DateTime  @default(now())
  assignedById        String    @db.Uuid
  reason              String?   @db.VarChar(500)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  representative PlatformSalesRepresentative @relation(fields: [representativeId], references: [id], onDelete: Restrict)
  platformTenant PlatformTenant              @relation(fields: [platformTenantId], references: [id], onDelete: Restrict)
  history        PlatformSalesCustomerOwnershipHistory[]

  @@index([representativeId])
  @@map("platform_sales_customer_ownership")
}

model PlatformSalesCustomerOwnershipHistory {
  id                  String   @id @default(uuid()) @db.Uuid
  ownershipId         String?  @db.Uuid
  representativeId    String?  @db.Uuid
  platformTenantId    String   @db.Uuid
  /// assigned | reassigned | removed
  action              String   @db.VarChar(32)
  actorPlatformUserId String   @db.Uuid
  reason              String?  @db.VarChar(500)
  createdAt           DateTime @default(now())

  ownership PlatformSalesCustomerOwnership? @relation(fields: [ownershipId], references: [id], onDelete: SetNull)

  @@index([platformTenantId, createdAt])
  @@index([representativeId, createdAt])
  @@index([ownershipId])
  @@map("platform_sales_customer_ownership_history")
}

