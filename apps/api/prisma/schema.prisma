// =============================================================================
// ── DOMAIN 15b · NOTIFICATION DELIVERY ENGINE (Phase 41d) ────────────────────
// =============================================================================
// Intent → immutable Message → DeliveryJob → Attempt/Receipt/DeadLetter.
// Config authority remains EffectiveNotificationView (41a–41c). These tables are
// the delivery SoR only — they do not store provider credentials or unrestricted PHI.

model NotificationIntent {
  id                 String    @id @default(uuid()) @db.Uuid
  tenantId           String    @db.Uuid
  branchId           String?   @db.Uuid
  recipientId        String    @db.Uuid
  recipientType      String    @default("user") @db.VarChar(20)
  notificationTypeId String?   @db.VarChar(100)
  category           String?   @db.VarChar(50)
  transactional      Boolean   @default(true)
  priority           String    @default("medium") @db.VarChar(20)
  requestedChannels  Json
  idempotencyKey     String    @db.VarChar(200)
  title              String    @db.VarChar(500)
  body               String    @db.Text
  titleAr            String?   @db.VarChar(500)
  bodyAr             String?   @db.Text
  locale             String    @default("en") @db.VarChar(10)
  metadata           Json      @default("{}")
  scheduledAt        DateTime?
  status             String    @default("created") @db.VarChar(40)
  correlationId      String?   @db.VarChar(100)
  causationId        String?   @db.VarChar(100)
  journeyInstanceId  String?   @db.Uuid
  workflowInstanceId String?   @db.Uuid
  activityId         String?   @db.Uuid
  requestedByUserId  String?   @db.Uuid
  producerModuleId   String?   @db.VarChar(100)
  providerKey        String?   @db.VarChar(100)
  schemaVersion      String    @default("1") @db.VarChar(10)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  tenant   Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  messages NotificationMessage[]
  jobs     DeliveryJob[]
  consents NotificationConsentDecision[]
  prefs    NotificationPreferenceSnapshot[]

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status])
  @@index([tenantId, recipientId])
  @@index([tenantId, createdAt])
  @@index([tenantId, notificationTypeId])
  @@index([tenantId, correlationId])
  @@index([tenantId, scheduledAt])
  @@map("notification_intents")
}

/// Immutable rendered payload. Retries reuse this record unless policy requires regeneration.
model NotificationMessage {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  intentId       String   @db.Uuid
  /// Optional link to legacy inbox / delivery-log Notification row.
  notificationId String?  @db.Uuid
  title          String   @db.VarChar(500)
  body           String   @db.Text
  html           String?  @db.Text
  locale         String   @db.VarChar(10)
  variables      Json     @default("{}")
  contentHash    String?  @db.VarChar(64)
  brandingRef    String?  @db.VarChar(100)
  branchSenderRef String? @db.VarChar(100)
  redactionClass String?  @db.VarChar(50)
  createdAt      DateTime @default(now())

  tenant Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  intent NotificationIntent @relation(fields: [intentId], references: [id], onDelete: Cascade)
  jobs   DeliveryJob[]

  @@index([tenantId, intentId])
  @@index([tenantId, notificationId])
  @@index([tenantId, createdAt])
  @@map("notification_messages")
}

model DeliveryJob {
