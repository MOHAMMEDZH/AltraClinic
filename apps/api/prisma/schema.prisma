  lastUsedAt           DateTime?
  createdBy            String    @db.Uuid
  rotatedFromId        String?   @db.Uuid
  rotationGraceEndsAt  DateTime?
  revokedAt            DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  tenant         Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  serviceAccount IntegrationServiceAccount? @relation(fields: [serviceAccountId], references: [id], onDelete: SetNull)

  @@unique([tenantId, keyHash])
  @@unique([keyHash])
  @@index([tenantId, status])
  @@index([tenantId, prefix])
  @@index([tenantId, ownerType, ownerId])
  @@index([tenantId, createdAt])
  @@index([status, rotationGraceEndsAt])
  @@index([status, expiresAt])
  @@map("integration_api_credentials")
