// ── DOMAIN 12 · CLINIC SUBSCRIPTIONS (Patient Treatment Plans) ───────────────
// =============================================================================

/// In-clinic subscription — e.g. an orthodontic treatment package for a patient.
/// Not to be confused with PlatformSubscription (SaaS billing at operator level).
model ClinicSubscription {
  id          String             @id @default(uuid()) @db.Uuid
  tenantId    String             @db.Uuid
  branchId    String?            @db.Uuid
  customerId  String             @db.Uuid
  plan        String             @db.VarChar(100)
  status      SubscriptionStatus @default(ACTIVE)
  startDate   DateTime
  endDate     DateTime?
  autoRenew   Boolean            @default(false)
  currency    String             @default("SYP") @db.VarChar(3)
  createdBy   String             @db.Uuid
  canceledAt  DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  patient     Patient            @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([tenantId, customerId])
  @@index([tenantId, status])
  @@map("clinic_subscriptions")
}

// =============================================================================
// ── DOMAIN 13 · PLATFORM ADMIN / SAAS BILLING ────────────────────────────────
// =============================================================================

/// Super Admin control-plane record — one per registered clinic.
/// Governs tenant lifecycle, entitlement plan, and data-residency.
/// Challenger note: PrivilegedAccessGrant is a separate table (not JSONB) to
/// support expiry-based cron cleanup and status-based queries.
model PlatformTenant {
  id                    String               @id @default(uuid()) @db.Uuid
  /// FK to Tenant — one-to-one binding
  tenantId              String               @unique @db.Uuid
  displayName           String               @db.VarChar(255)
  region                PlatformRegion
  plan                  EntitlementPlan      @default(LITE)
  /// null = unlimited (Enterprise plan)
  maxBranches           Int?
  /// null = unlimited (Enterprise plan)
  maxUsers              Int?
  status                PlatformTenantStatus @default(PROVISIONING)
  provisionedBy         String               @db.Uuid
  activatedAt           DateTime?
  suspendedAt           DateTime?
  suspensionReason      String?              @db.Text
  archivedAt            DateTime?
  archivedReason        String?              @db.Text
  /// Trial end date — cron job transitions to SUSPENDED on day 31
  trialEndsAt           DateTime?
  contractStartDate     DateTime?
  /// Primary dunning engine trigger date (T-90, T-30, T-7, T-1, T-0)
  contractEndDate       DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  tenant                Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  privilegedGrants      PrivilegedAccessGrant[]
  platformSubscriptions PlatformSubscription[]

  @@index([status])
  @@index([plan])
  /// Dunning engine cron indexes
  @@index([contractEndDate])
  @@index([trialEndsAt])
  @@map("platform_tenants")
}

/// JIT (just-in-time) privileged access grants for Super Admin operators.
/// Two-person-approved or break-glass; hard-capped at 8 hours.
model PrivilegedAccessGrant {
  id               String                      @id @default(uuid()) @db.Uuid
  platformTenantId String                      @db.Uuid
  adminId          String                      @db.Uuid
  adminName        String                      @db.VarChar(255)
  /// e.g. ["read_emr", "read_financials"]
  scopes           String[]
  justification    String                      @db.Text
  status           PrivilegedAccessGrantStatus @default(PENDING_APPROVAL)
  breakGlass       Boolean                     @default(false)
  requestedAt      DateTime                    @default(now())
  expiresAt        DateTime
  approvedBy       String?                     @db.Uuid
  approvedAt       DateTime?
  rejectedBy       String?                     @db.Uuid
  rejectedAt       DateTime?
  rejectedReason   String?                     @db.Text
  revokedAt        DateTime?
  revokedReason    String?                     @db.Text
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt

  platformTenant   PlatformTenant              @relation(fields: [platformTenantId], references: [id], onDelete: Cascade)

  @@index([platformTenantId])
  @@index([adminId])
  /// Cron job: find ACTIVE grants past expiresAt and auto-expire them
  @@index([status, expiresAt])
  @@map("privileged_access_grants")
}

/// SaaS billing record — the annual contract per clinic.
/// Billing is manual (Phase 1); auto-renewal hooks ready for Phase 2.
model PlatformSubscription {
  id                 String             @id @default(uuid()) @db.Uuid
  platformTenantId   String             @db.Uuid
  plan               EntitlementPlan
  status             SubscriptionStatus
  /// Spec: minimum 12-month commitment enforced here
  billingCycleMonths Int                @default(12)
  pricePerMonth      Decimal            @db.Decimal(18, 4)
  currency           String             @default("USD") @db.VarChar(3)
  startDate          DateTime
  endDate            DateTime?
  /// Phase 1: manual payment fields
  paidManuallyBy     String?            @db.Uuid
  paidManuallyAt     DateTime?
  paymentReference   String?            @db.VarChar(255)
  paymentNotes       String?            @db.Text
  /// Phase 2: auto-billing hook fields (populated by future cron/webhook)
  autoRenew          Boolean            @default(false)
  renewalAttemptedAt DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  platformTenant     PlatformTenant     @relation(fields: [platformTenantId], references: [id], onDelete: Restrict)

  @@index([platformTenantId])
  @@index([status])
  @@index([endDate])
  @@map("platform_subscriptions")
}

// =============================================================================
// ── DOMAIN 14 · PATIENT PORTAL ───────────────────────────────────────────────
// =============================================================================

model PortalAccount {
  id               String              @id @default(uuid()) @db.Uuid
  tenantId         String              @db.Uuid
  branchId         String?             @db.Uuid
  patientId        String              @unique @db.Uuid
  userId           String?             @db.Uuid
  status           PortalAccountStatus @default(INVITED)
  locale           String              @default("en") @db.VarChar(5)
  notifyEmail      Boolean             @default(true)
  notifySms        Boolean             @default(false)
  notifyPush       Boolean             @default(false)
