model LicenseLifecycleTransition {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  previousStatus String   @db.VarChar(50)
  newStatus      String   @db.VarChar(50)
  recordedAt     DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, previousStatus, newStatus])
  @@index([tenantId, recordedAt])
  @@map("license_lifecycle_transitions")
}

/// Idempotent communication dispatch ledger — one row per successful outbound send.
model CommunicationDispatchLedger {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  notificationId String   @unique @db.Uuid
  channel        String   @db.VarChar(20)
  usageMonth     String   @db.VarChar(7)
  createdAt      DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, usageMonth, channel])
  @@map("communication_dispatch_ledger")
}

