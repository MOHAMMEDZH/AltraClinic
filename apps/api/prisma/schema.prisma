  createdAt                 DateTime @default(now())

  lead PlatformSalesLead @relation(fields: [leadId], references: [id], onDelete: Restrict)

  @@index([leadId, createdAt])
  @@map("platform_sales_lead_ownership_history")
}

model PlatformSalesLeadNote {
  id          String   @id @default(uuid()) @db.Uuid
  leadId      String   @db.Uuid
  body        String   @db.VarChar(2000)
  createdById String   @db.Uuid
  createdAt   DateTime @default(now())

  lead PlatformSalesLead @relation(fields: [leadId], references: [id], onDelete: Restrict)

  @@index([leadId, createdAt])
  @@map("platform_sales_lead_notes")
