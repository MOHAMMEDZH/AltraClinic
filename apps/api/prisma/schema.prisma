/// Flexible Step 25 — Trial Creation and Customer Conversion.
/// Contract: docs/TRIAL_CREATION_AND_CUSTOMER_CONVERSION.md
/// Dedicated governance aggregate. Entitlements remain Step 16 snapshot + Step 18 EER only.
/// No Step 26 commission/productivity tables. No billing invoice/payment tables.
enum PlatformSalesTrialStatus {
  DRAFT
  PENDING_PROVISIONING
  ACTIVE
  EXPIRED
  CONVERTED
  CANCELLED

  @@map("platform_sales_trial_status")
}

model PlatformSalesTrial {
  id                      String                   @id @default(uuid()) @db.Uuid
  /// Null until Step 17 provisioning resolves/creates the tenant.
  platformTenantId        String?                  @db.Uuid
  originatingLeadId       String?                  @db.Uuid
  ownerRepresentativeId   String?                  @db.Uuid
  /// Immutable commercial attribution frozen at create (no Clinic/PHI authority).
  attributionSnapshotJson Json                     @default("{}")
  /// Immutable PUBLISHED Plan Version selected for the Trial.
  trialPlanVersionId      String                   @db.Uuid
  status                  PlatformSalesTrialStatus @default(DRAFT)
  organizationName        String                   @db.VarChar(255)
  facilityTypeKey         String                   @db.VarChar(128)
  selectedSpecialtyKeys   Json                     @default("[]")
  selectedModuleKeys      Json                     @default("[]")
  startsAt                DateTime?
  expiresAt               DateTime?
  /// Bounded policy value; never 0 = unlimited.
  maxExtensions           Int                      @default(2)
  extensionCount          Int                      @default(0)
  /// Step 16 commercial configuration link when established.
  commercialConfigId      String?                  @db.Uuid
  /// Step 17 provisioning correlation when established.
  provisioningRequestId   String?                  @db.Uuid
  /// Trial-only Add-on/Override grants requiring conversion disposition.
  trialOnlyGrantsJson     Json                     @default("[]")
  expiredAt               DateTime?
  cancelledAt             DateTime?
  cancellationReason      String?                  @db.VarChar(1000)
  createdByPlatformUserId String                   @db.Uuid
  rowVersion              Int                      @default(1)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  platformTenant      PlatformTenant?              @relation(fields: [platformTenantId], references: [id], onDelete: Restrict)
  originatingLead     PlatformSalesLead?           @relation(fields: [originatingLeadId], references: [id], onDelete: Restrict)
  ownerRepresentative PlatformSalesRepresentative? @relation(fields: [ownerRepresentativeId], references: [id], onDelete: Restrict)
  trialPlanVersion    PlatformPlanVersion          @relation(fields: [trialPlanVersionId], references: [id], onDelete: Restrict)
  extensionHistory    PlatformSalesTrialExtensionHistory[]
  conversions         PlatformSalesTrialConversion[]

  @@index([ownerRepresentativeId])
  @@index([status])
  /// Expiry job claim query: status = ACTIVE AND expiresAt <= now ORDER BY expiresAt, id
  @@index([status, expiresAt, id])
  @@index([expiresAt, id])
  @@index([createdAt, id])
  @@index([platformTenantId])
  @@index([originatingLeadId])
  @@index([trialPlanVersionId])
  @@map("platform_sales_trials")
}

model PlatformSalesTrialExtensionHistory {
  id                  String   @id @default(uuid()) @db.Uuid
  trialId             String   @db.Uuid
  previousExpiresAt   DateTime
  newExpiresAt        DateTime
  extensionDays       Int
  reason              String   @db.VarChar(1000)
  exceptional         Boolean  @default(false)
  actorPlatformUserId String   @db.Uuid
  correlationId       String?  @db.VarChar(100)
  createdAt           DateTime @default(now())

  trial PlatformSalesTrial @relation(fields: [trialId], references: [id], onDelete: Restrict)

  @@index([trialId, createdAt])
  @@map("platform_sales_trial_extension_history")
}

model PlatformSalesTrialConversion {
  id                     String   @id @default(uuid()) @db.Uuid
  trialId                String   @db.Uuid
  targetPaidPlanVersionId String  @db.Uuid
  /// Explicit disposition per trial-only grant. Ambiguity fails conversion safely.
  dispositionsJson       Json     @default("[]")
  actorPlatformUserId    String   @db.Uuid
  convertedAt            DateTime @default(now())
  correlationId          String?  @db.VarChar(100)
  outboxEventId          String?  @db.Uuid
  commercialConfigId     String?  @db.Uuid
  createdAt              DateTime @default(now())

  trial                PlatformSalesTrial  @relation(fields: [trialId], references: [id], onDelete: Restrict)
  targetPaidPlanVersion PlatformPlanVersion @relation("TrialConversionTargetPlanVersion", fields: [targetPaidPlanVersionId], references: [id], onDelete: Restrict)

  @@unique([trialId])
  @@index([targetPaidPlanVersionId])
  @@index([convertedAt, id])
  @@map("platform_sales_trial_conversions")
}

/// Flexible Step 26 — Sales Productivity and Commission Snapshot (review records only).
/// Contract: docs/SALES_PRODUCTIVITY_AND_COMMISSION_SNAPSHOT.md
/// Not payroll / not a money-movement ledger. calculationStatus stays UNCONFIGURED (no invented rates).
/// Partial unique (non-SUPERSEDED) enforced in migration SQL — Prisma cannot express WHERE clauses.
model PlatformSalesCommissionSnapshot {
  id                         String    @id @default(uuid()) @db.Uuid
  representativeId           String    @db.Uuid
  /// Calendar month key YYYY-MM
  periodKey                  String    @db.VarChar(16)
  periodTimezone             String    @default("UTC") @db.VarChar(64)
  periodStart                DateTime
  /// Exclusive end bound (first instant of next period).
  periodEnd                  DateTime
  sourceCutoffAt             DateTime
  formulaVersion             String    @db.VarChar(64)
  /// Always UNCONFIGURED until a future authorized rate engine exists.
  calculationStatus          String    @default("UNCONFIGURED") @db.VarChar(32)
  ruleReference              String?   @db.VarChar(128)
  computedAmount             Decimal?  @db.Decimal(18, 4)
  metricsJson                Json
  planVersionAttributionJson Json
  addOnAttributionJson       Json
  completenessJson           Json
  reconciliationJson         Json?
  /// NONE | IN_REVIEW | REVIEWED | REJECTED
  reviewStatus               String    @default("NONE") @db.VarChar(32)
  /// UNPAID | PAID — administrative metadata only; never moves money.
  paidStatus                 String    @default("UNPAID") @db.VarChar(32)
  paidReason                 String?   @db.VarChar(500)
  paidReference              String?   @db.VarChar(200)
  paidAt                     DateTime?
  paidByPlatformUserId       String?   @db.Uuid
  /// DRAFT | FINALIZED | SUPERSEDED
  status                     String    @db.VarChar(32)
  supersedesSnapshotId       String?   @db.Uuid
  rowVersion                 Int       @default(1)
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt
  finalizedAt                DateTime?

  representative PlatformSalesRepresentative @relation(fields: [representativeId], references: [id], onDelete: Restrict)
  supersedes     PlatformSalesCommissionSnapshot?  @relation("CommissionSnapshotSupersede", fields: [supersedesSnapshotId], references: [id], onDelete: Restrict)
  supersededBy   PlatformSalesCommissionSnapshot[] @relation("CommissionSnapshotSupersede")

  @@index([representativeId, periodKey])
  @@index([periodKey, periodTimezone])
  @@index([status])
  @@index([reviewStatus])
  @@index([paidStatus])
  @@index([createdAt, id])
  @@map("platform_sales_commission_snapshots")
}

/// Flexible Step 27 — Platform notification preferences (mandatory categories cannot be disabled in API).
/// Contract: docs/NOTIFICATIONS_AND_TEMPLATES.md
model PlatformNotificationPreference {
  id             String   @id @default(uuid()) @db.Uuid
  platformUserId String   @db.Uuid
  /// security | lifecycle | commercial | usage | operational | sales | sales_manager
  category       String   @db.VarChar(64)
  /// email (platform); in-app reserved for clinic path
  channel        String   @db.VarChar(32)
  enabled        Boolean  @default(true)
  locale         String   @default("en-US") @db.VarChar(16)
  rowVersion     Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  platformUser PlatformUser @relation(fields: [platformUserId], references: [id], onDelete: Cascade)

  @@unique([platformUserId, category, channel])
  @@index([platformUserId, category])
  @@map("platform_notification_preferences")
}
