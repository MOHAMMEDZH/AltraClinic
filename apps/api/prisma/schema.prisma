/// Flexible Step 23 — Sales Representative profile (Platform identity extension; no credentials).
/// Contract: docs/SALES_REPRESENTATIVE_MANAGEMENT.md
enum PlatformSalesRepresentativeStatus {
  PENDING_ACTIVATION
  ACTIVE
  SUSPENDED
  DISABLED

  @@map("platform_sales_representative_status")
}

enum PlatformSalesTargetPeriod {
  MONTH
  QUARTER
  YEAR

  @@map("platform_sales_target_period")
}

model PlatformSalesRepresentative {
  id                      String                            @id @default(uuid()) @db.Uuid
  platformUserId          String                            @unique @db.Uuid
  status                  PlatformSalesRepresentativeStatus @default(PENDING_ACTIVATION)
  managerRepresentativeId String?                           @db.Uuid
  regionCode              String?                           @db.VarChar(64)
  territoryCode           String?                           @db.VarChar(64)
  targetAmount            Decimal?                          @db.Decimal(18, 4)
  targetCurrency          String?                           @db.VarChar(8)
  targetPeriod            PlatformSalesTargetPeriod?
  rowVersion              Int                               @default(1)
  createdAt               DateTime                          @default(now())
  updatedAt               DateTime                          @updatedAt

  platformUser PlatformUser                 @relation(fields: [platformUserId], references: [id], onDelete: Restrict)
  manager      PlatformSalesRepresentative? @relation("SalesRepManager", fields: [managerRepresentativeId], references: [id], onDelete: Restrict)
  reports      PlatformSalesRepresentative[] @relation("SalesRepManager")
  ownerships   PlatformSalesCustomerOwnership[]
  /// Flexible Step 24 — leads owned by this representative.
  ownedLeads   PlatformSalesLead[]
  /// Flexible Step 25 — Trials owned by this representative.
  ownedTrials  PlatformSalesTrial[]
  /// Flexible Step 26 — commission snapshot review records for this representative.
  commissionSnapshots PlatformSalesCommissionSnapshot[]

  @@index([status])
  @@index([managerRepresentativeId])
  @@index([regionCode])
  @@index([territoryCode])
  @@map("platform_sales_representatives")
}

/// Commercial relationship ownership only — never Clinic/PHI/entitlement/subscription authority.
