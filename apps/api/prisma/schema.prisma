/// Defines commission rules per provider and/or service type.
/// null providerId = applies to all providers; null serviceType = all services.
model CommissionRule {
  id                String             @id @default(uuid()) @db.Uuid
  tenantId          String             @db.Uuid
  providerId        String?            @db.Uuid
  serviceType       String?            @db.VarChar(100)
  rateType          CommissionRateType
  rateValue         Decimal            @db.Decimal(10, 4)
  minimumThreshold  Decimal?           @db.Decimal(18, 4)
  maximumCap        Decimal?           @db.Decimal(18, 4)
  effectiveDate     DateTime           @db.Date
  expiryDate        DateTime?          @db.Date
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([tenantId, providerId])
  @@index([tenantId, effectiveDate])
  @@map("commission_rules")
}

model CommissionCalculation {
  id                String           @id @default(uuid()) @db.Uuid
  tenantId          String           @db.Uuid
  branchId          String?          @db.Uuid
  providerId        String           @db.Uuid
  patientId         String?          @db.Uuid
  periodStart       DateTime
  periodEnd         DateTime
  status            CommissionStatus @default(CALCULATED)
  totalRevenue      Decimal          @db.Decimal(18, 4)
  commissionAmount  Decimal          @db.Decimal(18, 4)
  currency          String           @default("SYP") @db.VarChar(3)
  /// Array of invoice IDs this calculation is based on
  basisDocumentIds  String[]
  paymentMethod     String?          @db.VarChar(50)
  paymentReference  String?          @db.VarChar(255)
  paymentDate       DateTime?
  disputeReason     String?          @db.Text
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  patient           Patient?         @relation(fields: [patientId], references: [id], onDelete: SetNull)
  lineItems         CommissionLineItem[]

  @@index([tenantId])
  @@index([tenantId, providerId])
  @@index([tenantId, status])
  @@index([tenantId, periodStart, periodEnd])
  @@map("commission_calculations")
}

model CommissionLineItem {
  id                   String                @id @default(uuid()) @db.Uuid
  commissionId         String                @db.Uuid
  tenantId             String                @db.Uuid
  appointmentId        String?               @db.Uuid
  serviceDescription   String                @db.VarChar(500)
  serviceType          String?               @db.VarChar(100)
  amount               Decimal               @db.Decimal(18, 4)
  commissionRateType   CommissionRateType
  commissionRateValue  Decimal               @db.Decimal(10, 4)
  minimumThreshold     Decimal?              @db.Decimal(18, 4)
  maximumCap           Decimal?              @db.Decimal(18, 4)
  commissionAmount     Decimal               @db.Decimal(18, 4)
  date                 DateTime
  createdAt            DateTime              @default(now())

  commission           CommissionCalculation @relation(fields: [commissionId], references: [id], onDelete: Cascade)

  @@index([commissionId])
  @@index([tenantId])
  @@map("commission_line_items")
}

// =============================================================================
// ── DOMAIN 11 · LOYALTY ──────────────────────────────────────────────────────
// =============================================================================

/// One loyalty account per patient per tenant (unique constraint enforced).
model LoyaltyAccount {
  id                   String                 @id @default(uuid()) @db.Uuid
  tenantId             String                 @db.Uuid
  patientId            String                 @unique @db.Uuid
  /// Clinic/branch scope for multi-branch point pooling
  clinicId             String                 @db.Uuid
  pointsBalance        Int                    @default(0)
  lifetimePointsEarned Int                    @default(0)
  tier                 LoyaltyTier            @default(BRONZE)
  enrollmentDate       DateTime               @default(now())
  lastActivityDate     DateTime               @default(now())
  isActive             Boolean                @default(true)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  tenant               Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  patient              Patient                @relation(fields: [patientId], references: [id], onDelete: Cascade)
  transactions         LoyaltyTransaction[]
  rewards              LoyaltyReward[]

  @@index([tenantId])
  @@index([tenantId, tier])
  @@index([tenantId, isActive])
  @@map("loyalty_accounts")
}

/// Append-only ledger of every points earn/redeem/adjust event.
model LoyaltyTransaction {
  id              String                 @id @default(uuid()) @db.Uuid
  accountId       String                 @db.Uuid
  tenantId        String                 @db.Uuid
  type            LoyaltyTransactionType
  pointsAmount    Int
  /// Invoice ID or external reference
  reference       String?                @db.VarChar(255)
  description     String?                @db.Text
  /// Running balance after this transaction (denormalized for ledger reads — populated async)
  balanceAfter    Int?
  transactionDate DateTime               @default(now())
  createdAt       DateTime               @default(now())

  account         LoyaltyAccount         @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@map("loyalty_transactions")
}

enum LoyaltyRewardStatus {
  AVAILABLE
  EXPIRED
  REDEEMED

  @@map("loyalty_reward_status")
}

/// Account-scoped reward instances issued to a specific loyalty account.
model LoyaltyReward {
  id             String             @id @default(uuid()) @db.Uuid
  tenantId       String             @db.Uuid
  /// The loyalty account this reward belongs to
  accountId      String             @db.Uuid
  pointsRequired Int
  description    String             @db.Text
  metadata       Json?
  expiryDate     DateTime?
  status         LoyaltyRewardStatus @default(AVAILABLE)
  redeemedDate   DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  deletedAt      DateTime?

  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  account        LoyaltyAccount     @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([accountId])
  @@index([tenantId, status])
  @@index([tenantId, deletedAt])
  @@map("loyalty_rewards")
}

