/// Flexible Step 24 — Leads and Sales Pipeline (Lead is the only CRM aggregate).
/// Contract: docs/LEADS_AND_SALES_PIPELINE.md
/// No opportunities table, no pipeline_stages table, no trials.
enum PlatformSalesLeadStage {
  NEW
  CONTACTED
  QUALIFIED
  DEMO_SCHEDULED
  PROPOSAL
  WON
  LOST

  @@map("platform_sales_lead_stage")
}

enum PlatformSalesLeadSource {
  INBOUND
  OUTBOUND
  REFERRAL
  PARTNER
  EVENT
  OTHER

  @@map("platform_sales_lead_source")
}

enum PlatformSalesDemoStatus {
  NONE
  SCHEDULED
  COMPLETED
  CANCELLED

  @@map("platform_sales_demo_status")
}

model PlatformSalesLead {
  id                     String                  @id @default(uuid()) @db.Uuid
  stage                  PlatformSalesLeadStage  @default(NEW)
  source                 PlatformSalesLeadSource @default(OTHER)
  ownerRepresentativeId  String?                 @db.Uuid
  organizationName       String                  @db.VarChar(255)
  contactName            String                  @db.VarChar(255)
  contactEmail           String?                 @db.VarChar(320)
  contactPhone           String?                 @db.VarChar(64)
  contactJobTitle        String?                 @db.VarChar(160)
  facilityTypeKey        String?                 @db.VarChar(128)
  specialtyKeys          Json                    @default("[]")
  desiredModuleKeys      Json                    @default("[]")
  estimatedUsers         Int?
  estimatedProviders     Int?
  estimatedLocations     Int?
  nextActionType         String?                 @db.VarChar(64)
  nextActionDueAt        DateTime?
  nextActionNote         String?                 @db.VarChar(500)
  demoScheduledAt        DateTime?
  demoTimezone           String?                 @db.VarChar(64)
  demoStatus             PlatformSalesDemoStatus @default(NONE)
  demoNote               String?                 @db.VarChar(500)
