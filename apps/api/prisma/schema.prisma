/// Two-person-approval lifecycle: draft → validated → deployed → retired.
/// A model cannot be validated by the same user who created it (domain rule).
model AiModel {
  id              String        @id @default(uuid()) @db.Uuid
  tenantId        String        @db.Uuid
  branchId        String?       @db.Uuid
  nameEn          String        @db.VarChar(255)
  nameAr          String        @db.VarChar(255)
  descriptionEn   String        @db.Text
  descriptionAr   String        @db.Text
  /// e.g. "xray_analysis" | "treatment_recommendation" | "risk_scoring"
  modelType       String        @db.VarChar(50)
  version         String        @db.VarChar(50)
  status          AiModelStatus @default(DRAFT)
  createdBy       String        @db.Uuid
  validatedBy     String?       @db.Uuid
  validatedAt     DateTime?
  validationNotes String?       @db.Text
  deployedBy      String?       @db.Uuid
  deployedAt      DateTime?
  retiredBy       String?       @db.Uuid
  retiredAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("ai_models")
}

model AiConversation {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  userId      String   @db.Uuid
  branchId    String?  @db.Uuid
  title       String   @db.VarChar(255)
  workspaceId String?  @db.VarChar(50)
  pinned      Boolean  @default(false)
  contextJson Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  messages    AiMessage[]

  @@index([tenantId, userId, updatedAt])
  @@map("ai_conversations")
}

model AiMessage {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @db.Uuid
  conversationId  String   @db.Uuid
  role            String   @db.VarChar(20)
  content         String   @db.Text
  citationsJson   Json     @default("[]")
  attachmentsJson Json     @default("[]")
  tokenCount      Int      @default(0)
  createdAt       DateTime @default(now())

  conversation    AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("ai_messages")
}

model AiPrompt {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  userId    String?  @db.Uuid
  category  String   @db.VarChar(50)
  titleEn   String   @db.VarChar(255)
  titleAr   String?  @db.VarChar(255)
  bodyEn    String   @db.Text
  bodyAr    String?  @db.Text
