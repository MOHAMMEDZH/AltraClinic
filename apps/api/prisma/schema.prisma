// =============================================================================
// ── DOMAIN 19 · MEDIA & ATTACHMENTS ──────────────────────────────────────────
// =============================================================================

/// Tenant-scoped media asset with processing variants stored as JSONB.
/// Storage keys point to object storage (local filesystem or S3); never serve directly.
model MediaAsset {
  id                  String                @id @default(uuid()) @db.Uuid
  tenantId            String                @db.Uuid
  branchId            String?               @db.Uuid
  category            MediaCategory
  /// Owner entity type: patient, encounter, appointment, beauty_service, etc.
  ownerType           String                @db.VarChar(50)
  ownerId             String                @db.Uuid
  patientId           String?               @db.Uuid
  originalFilename    String                @db.VarChar(500)
  mimeType            String                @db.VarChar(127)
  sizeBytes           BigInt
  status              MediaAssetStatus      @default(PENDING_SCAN)
  virusScanStatus     VirusScanStatus       @default(PENDING)
  /// Primary storage key for the original upload (quarantine or final)
  storageKey          String                @db.VarChar(1000)
  /// Processed variants: [{ type, storageKey, mimeType, sizeBytes, width?, height? }]
  variants            Json                  @default("[]")
  /// Extracted metadata (dimensions, format, stripped EXIF summary — no PII)
  metadata            Json                  @default("{}")
  /// For BEAUTY_BEFORE_AFTER: links before/after pairs
  comparisonGroupId   String?               @db.Uuid
  comparisonRole      BeautyComparisonRole?
  uploadedBy          String                @db.Uuid
  quarantineReason    String?               @db.Text
  processedAt         DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  deletedAt           DateTime?

  tenant              Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  patient             Patient?              @relation(fields: [patientId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, category])
  @@index([tenantId, ownerType, ownerId])
  @@index([tenantId, patientId])
  @@index([tenantId, status])
  @@index([tenantId, comparisonGroupId])
  @@index([deletedAt])
  @@map("media_assets")
}

// =============================================================================
// ── INFRASTRUCTURE · TRANSACTIONAL OUTBOX ────────────────────────────────────
// =============================================================================

/// Transactional outbox for reliable domain event delivery.
/// Processor queries: WHERE status = 'PENDING' ORDER BY created_at ASC LIMIT 100
/// tenantId is nullable for cross-tenant platform-level events.
model OutboxEvent {
  id             String            @id @default(uuid()) @db.Uuid
  tenantId       String?           @db.Uuid
  eventType      String            @db.VarChar(100)
  aggregateType  String            @db.VarChar(100)
  aggregateId    String            @db.Uuid
  payload        Json
  status         OutboxEventStatus @default(PENDING)
  attempts       Int               @default(0)
  lastAttemptAt  DateTime?
  publishedAt    DateTime?
  errorMessage   String?           @db.Text
  createdAt      DateTime          @default(now())

  @@index([status, createdAt])
  @@index([aggregateType, aggregateId])
  @@index([tenantId])
  @@map("outbox_events")
}

/// Phase 42c — Import/Export Job Engine (orchestration metadata only; no business payload).
model ImportExportJob {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @db.Uuid
  branchId          String?   @db.Uuid
  typeId            String    @db.VarChar(120)
  direction         String    @db.VarChar(20)
  status            String    @default("draft") @db.VarChar(40)
  priority          String    @default("normal") @db.VarChar(20)
  initiatedByUserId String    @db.Uuid
  idempotencyKey    String    @db.VarChar(200)
  correlationId     String    @db.VarChar(100)
  causationId       String?   @db.VarChar(100)
  attemptCount      Int       @default(0)
  maxAttempts       Int       @default(3)
  baseDelayMs       Int       @default(1000)
  maxDelayMs        Int       @default(60000)
  lastError         String?   @db.VarChar(1000)
  failureReason     String?   @db.VarChar(80)
  warningCount      Int       @default(0)
  metadata          Json      @default("{}")
  scheduledAt       DateTime?
  startedAt         DateTime?
  completedAt       DateTime?
  deadLetteredAt    DateTime?
  expiresAt         DateTime?
  leasedAt          DateTime?
  leaseOwner        String?   @db.VarChar(100)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant      Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  deadLetters ImportExportDeadLetter[]
  artifacts   ImportExportArtifact[]

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([tenantId, typeId])
  @@index([tenantId, correlationId])
  @@index([status, expiresAt])
  @@map("import_export_jobs")
}

model ImportExportDeadLetter {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  jobId         String   @db.Uuid
  reason        String   @db.VarChar(500)
  attempts      Int
  lastError     String?  @db.VarChar(1000)
  correlationId String   @db.VarChar(100)
  createdAt     DateTime @default(now())

  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  job    ImportExportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([tenantId, jobId])
  @@map("import_export_dead_letters")
}

/// Phase 42e — Export artifact metadata (storage key is opaque; no public filesystem paths).
model ImportExportArtifact {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @db.Uuid
  jobId             String    @db.Uuid
  format            String    @db.VarChar(20)
  sizeBytes         Int
  checksum          String    @db.VarChar(128)
  contentType       String    @db.VarChar(120)
  filename          String    @db.VarChar(255)
  status            String    @default("preparing") @db.VarChar(40)
  storageKey        String    @db.VarChar(500)
  downloadTokenHash String    @db.VarChar(128)
  expiresAt         DateTime
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  job    ImportExportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([tenantId, jobId])
  @@index([tenantId, status])
  @@index([status, expiresAt])
  @@map("import_export_artifacts")
}
