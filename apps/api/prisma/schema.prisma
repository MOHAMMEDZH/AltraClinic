model PortalAccount {
  id               String              @id @default(uuid()) @db.Uuid
  tenantId         String              @db.Uuid
  branchId         String?             @db.Uuid
  patientId        String              @unique @db.Uuid
  userId           String?             @db.Uuid
  status           PortalAccountStatus @default(INVITED)
  locale           String              @default("en") @db.VarChar(5)
  notifyEmail      Boolean             @default(true)
  notifySms        Boolean             @default(false)
  notifyPush       Boolean             @default(false)
  invitedBy        String              @db.Uuid
  /// SHA-256 of one-time enrollment activation token (raw token never stored)
  enrollmentTokenHash String?          @db.VarChar(64)
  enrollmentTokenExpiresAt DateTime?
  /// Timestamp when enrollment consent was captured (Phase 46b)
  enrollmentConsentAt DateTime?
  activatedAt      DateTime?
  suspendedAt      DateTime?
  suspensionReason String?             @db.Text
  deactivatedAt    DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  tenant           Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  patient          Patient             @relation(fields: [patientId], references: [id], onDelete: Cascade)
  caregiverGrants  CaregiverAccessGrant[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, userId])
  @@unique([enrollmentTokenHash])
  @@map("portal_accounts")
}

/// Consent-based delegation allowing a caregiver to access a patient's portal.
/// Hard cap of 5 active grants per account enforced in domain layer.
model CaregiverAccessGrant {
  id               String        @id @default(uuid()) @db.Uuid
  portalAccountId  String        @db.Uuid
  caregiverContact String        @db.VarChar(255)
  caregiverName    String        @db.VarChar(255)
  scopes           String[]
  grantedBy        String        @db.VarChar(255)
  grantedAt        DateTime      @default(now())
  expiresAt        DateTime?
  revokedAt        DateTime?
  revokedReason    String?       @db.Text
  /// Phase 46d lifecycle: invited | active | declined | revoked
  status           String        @default("active") @db.VarChar(32)
  invitationTokenHash String?    @db.VarChar(64)
  invitationExpiresAt DateTime?
  acceptedAt       DateTime?
  declinedAt       DateTime?
  caregiverUserId  String?       @db.Uuid
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  portalAccount    PortalAccount @relation(fields: [portalAccountId], references: [id], onDelete: Cascade)

  @@index([portalAccountId])
  @@index([expiresAt])
  @@index([invitationTokenHash])
  @@index([caregiverUserId])
  @@map("caregiver_access_grants")
}

