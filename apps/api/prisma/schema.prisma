// =============================================================================
// ── DOMAIN · PHASE 47 STEP 12 — HEALTHCARE CATALOG (METADATA SoR) ────────────
// Catalog identity, localization, lifecycle, aliases, and compatibility rules.
// Does NOT grant runtime entitlements (LicensingEngineService remains authority).
// No Plan / Plan Version / Add-on / Override / tenant-assignment tables.
// =============================================================================

enum HealthcareCatalogKind {
  FACILITY_TYPE
  SPECIALTY
  MODULE
  FEATURE
  LIMIT
}

enum HealthcareCatalogLifecycle {
  DRAFT
  ACTIVE
  DEPRECATED
  RETIRED
}

enum HealthcareCatalogRuleType {
  REQUIRES
  REQUIRES_ANY_OF
  INCOMPATIBLE_WITH
  ALLOWED_FOR
  NOT_ALLOWED_FOR
}

enum HealthcareCatalogLimitValueType {
  INTEGER
  DECIMAL
  DURATION
  BYTES
  COUNT
}

/// Authoritative healthcare catalog entry. Canonical keys are immutable.
model HealthcareCatalogItem {
  id                       String                         @id @default(uuid()) @db.Uuid
  canonicalKey             String                         @unique @db.VarChar(128)
  kind                     HealthcareCatalogKind
  lifecycle                HealthcareCatalogLifecycle     @default(DRAFT)
  sortOrder                Int                            @default(0)
  iconKey                  String?                        @db.VarChar(64)
  parentItemId             String?                        @db.Uuid
  owningModuleItemId       String?                        @db.Uuid
  systemSeeded             Boolean                        @default(false)
  version                  Int                            @default(1)
  replacementCanonicalKey  String?                        @db.VarChar(128)
  limitValueType           HealthcareCatalogLimitValueType?
  limitUnit                String?                        @db.VarChar(64)
  limitMin                 Decimal?                       @db.Decimal(18, 4)
  limitMax                 Decimal?                       @db.Decimal(18, 4)
  limitZeroValid           Boolean?
  limitUnlimitedSupported  Boolean?
  createdAt                DateTime                       @default(now())
  updatedAt                DateTime                       @updatedAt

  parent                   HealthcareCatalogItem?         @relation("CatalogItemParent", fields: [parentItemId], references: [id], onDelete: Restrict)
  children                 HealthcareCatalogItem[]        @relation("CatalogItemParent")
  owningModule             HealthcareCatalogItem?         @relation("CatalogItemOwningModule", fields: [owningModuleItemId], references: [id], onDelete: Restrict)
  ownedCapabilities        HealthcareCatalogItem[]        @relation("CatalogItemOwningModule")
  translations             HealthcareCatalogTranslation[]
  aliases                  HealthcareCatalogAlias[]
  rulesAsSubject           HealthcareCatalogCompatibilityRule[] @relation("CatalogRuleSubject")
  rulesAsTarget            HealthcareCatalogCompatibilityRule[] @relation("CatalogRuleTarget")
  planVersionEntitlements  PlatformPlanVersionEntitlement[]
  planVersionLimits        PlatformPlanVersionLimit[]
  addOnVersionEntitlements PlatformAddOnVersionEntitlement[]
  addOnVersionLimitEffects PlatformAddOnVersionLimitEffect[]
  commercialOverrideEffects PlatformCommercialOverrideEffect[]

  @@index([kind, lifecycle])
  @@index([sortOrder])
  @@map("healthcare_catalog_items")
}

model HealthcareCatalogTranslation {
  id               String                @id @default(uuid()) @db.Uuid
  itemId           String                @db.Uuid
  locale           String                @db.VarChar(10)
  displayName      String                @db.VarChar(200)
  shortDescription String                @db.VarChar(500)
  longDescription  String?               @db.Text
  helpText         String?               @db.VarChar(500)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  item HealthcareCatalogItem @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@unique([itemId, locale])
  @@index([locale, displayName])
  @@map("healthcare_catalog_translations")
}

model HealthcareCatalogAlias {
  id              String                     @id @default(uuid()) @db.Uuid
  itemId          String                     @db.Uuid
  aliasValue      String                     @db.VarChar(128)
  sourceNamespace String                     @db.VarChar(64)
  lifecycle       HealthcareCatalogLifecycle @default(ACTIVE)
  reason          String?                    @db.VarChar(500)
  createdAt       DateTime                   @default(now())
  retiredAt       DateTime?

  item HealthcareCatalogItem @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@unique([sourceNamespace, aliasValue])
  @@index([itemId])
  @@map("healthcare_catalog_aliases")
}

model HealthcareCatalogCompatibilityRule {
  id              String                     @id @default(uuid()) @db.Uuid
  ruleType        HealthcareCatalogRuleType
  subjectItemId   String                     @db.Uuid
  targetItemId    String                     @db.Uuid
  anyOfGroupKey   String                     @default("") @db.VarChar(64)
  lifecycle       HealthcareCatalogLifecycle @default(DRAFT)
  explanationEn   String                     @db.VarChar(500)
  explanationAr   String                     @db.VarChar(500)
  systemSeeded    Boolean                    @default(false)
  version         Int                        @default(1)
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  subject HealthcareCatalogItem @relation("CatalogRuleSubject", fields: [subjectItemId], references: [id], onDelete: Restrict)
  target  HealthcareCatalogItem @relation("CatalogRuleTarget", fields: [targetItemId], references: [id], onDelete: Restrict)

  @@unique([ruleType, subjectItemId, targetItemId, anyOfGroupKey])
  @@index([lifecycle, ruleType])
  @@map("healthcare_catalog_compatibility_rules")
}

/// Durable Catalog mutation idempotency (create item / create rule).
/// Stores request hash + result identity only — never raw bodies, tokens, or translations.
model HealthcareCatalogIdempotencyRecord {
  id                 String   @id @default(uuid()) @db.Uuid
  actorId            String   @db.Uuid
  operation          String   @db.VarChar(64)
  idempotencyKey     String   @db.VarChar(128)
  requestHash        String   @db.VarChar(64)
  resultResourceType String   @db.VarChar(32)
  resultResourceId   String   @db.Uuid
  status             String   @db.VarChar(16)
  createdAt          DateTime @default(now())
  expiresAt          DateTime

  @@unique([actorId, operation, idempotencyKey])
  @@index([expiresAt])
  @@map("healthcare_catalog_idempotency")
}

// ─── Phase 47 Step 13 — Platform Plans & Plan Versions ─────────────────────
// Commercial metadata SoR only. No entitlements, limits, add-ons, overrides,
// or subscription Plan Version FKs. Does not alter LicensingEngineService.

enum PlatformPlanLifecycle {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum PlatformPlanVersionLifecycle {
  DRAFT
  PUBLISHED
  RETIRED
}

/// Step 14 — commercial definition ownership for seed/import safety.
/// UNINITIALIZED: seed may populate once.
/// SEED_INITIALIZED: seed already populated; never re-seed.
/// ADMINISTRATOR_OWNED: operator saved (including intentional empty); never re-seed.
enum PlatformPlanCommercialDefinitionOwnership {
  UNINITIALIZED
  SEED_INITIALIZED
  ADMINISTRATOR_OWNED
}

enum PlatformPlanAliasLifecycle {
  ACTIVE
  RETIRED
}

/// Stable commercial product family. Canonical key immutable.
model PlatformPlan {
  id           String               @id @default(uuid()) @db.Uuid
  canonicalKey String               @unique @db.VarChar(128)
  lifecycle    PlatformPlanLifecycle @default(DRAFT)
  sortOrder    Int                  @default(0)
  systemSeeded Boolean              @default(false)
  version      Int                  @default(1)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  translations PlatformPlanTranslation[]
  aliases      PlatformPlanAlias[]
  versions     PlatformPlanVersion[]

  @@index([lifecycle, sortOrder])
  @@map("platform_plans")
}

model PlatformPlanTranslation {
  id               String   @id @default(uuid()) @db.Uuid
  planId           String   @db.Uuid
  locale           String   @db.VarChar(10)
  displayName      String   @db.VarChar(200)
  shortDescription String   @db.VarChar(500)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  plan PlatformPlan @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@unique([planId, locale])
  @@index([locale, displayName])
  @@map("platform_plan_translations")
}

/// Controlled legacy identifier mapping. No automatic subscription migration.
model PlatformPlanAlias {
  id               String                     @id @default(uuid()) @db.Uuid
  planId           String                     @db.Uuid
  sourceNamespace  String                     @db.VarChar(64)
  aliasValue       String                     @db.VarChar(128)
  normalizedValue  String                     @db.VarChar(128)
  lifecycle        PlatformPlanAliasLifecycle @default(ACTIVE)
  migrationNote    String?                    @db.VarChar(500)
  version          Int                        @default(1)
  createdAt        DateTime                   @default(now())
  retiredAt        DateTime?

  plan PlatformPlan @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@unique([sourceNamespace, aliasValue])
  @@index([planId, lifecycle])
  @@index([sourceNamespace, normalizedValue])
  @@map("platform_plan_aliases")
}

/// Versioned commercial metadata snapshot. Published rows are immutable.
model PlatformPlanVersion {
  id                      String                        @id @default(uuid()) @db.Uuid
  planId                  String                        @db.Uuid
  versionNumber           Int
  lifecycle               PlatformPlanVersionLifecycle  @default(DRAFT)
  /// Optimistic concurrency token (independent of commercial versionNumber).
  rowVersion              Int                           @default(1)
  effectiveFrom           DateTime?
  retireAt                DateTime?
  trialDefaultEnabled     Boolean?
  trialDefaultDays        Int?
  /// Pricing intentionally nullable — Step 13 marks unavailable when null.
  priceAmountMinor        Int?
  priceCurrency           String?                       @db.VarChar(3)
  billingInterval         String?                       @db.VarChar(16)
  billingIntervalCount    Int?
  internalReleaseNotes    String?                       @db.VarChar(2000)
  publishedAt             DateTime?
  publishedByPlatformUserId String?                     @db.Uuid
  publicationFingerprint  String?                       @db.VarChar(64)
  publicationReason       String?                       @db.VarChar(500)
  sourceVersionId         String?                       @db.Uuid
  systemSeeded            Boolean                       @default(false)
  /// Step 14 seed ownership — never infer from child-row count alone.
  commercialDefinitionOwnership PlatformPlanCommercialDefinitionOwnership @default(UNINITIALIZED)
  createdAt               DateTime                      @default(now())
  updatedAt               DateTime                      @updatedAt

  plan         PlatformPlan                   @relation(fields: [planId], references: [id], onDelete: Restrict)
  sourceVersion PlatformPlanVersion?          @relation("PlanVersionCloneSource", fields: [sourceVersionId], references: [id], onDelete: Restrict)
  clones       PlatformPlanVersion[]          @relation("PlanVersionCloneSource")
  translations PlatformPlanVersionTranslation[]
  entitlements PlatformPlanVersionEntitlement[]
  limits       PlatformPlanVersionLimit[]
  /// Step 16 commercial Plan Version assignments (definition remains immutable).
  commercialConfigs PlatformSubscriptionCommercialConfig[]
  /// Flexible Step 25 — Trial Plan Version selections (immutable at activation).
  salesTrials       PlatformSalesTrial[]
  /// Flexible Step 25 — conversion target paid Plan Versions.
  trialConversionTargets PlatformSalesTrialConversion[] @relation("TrialConversionTargetPlanVersion")

  @@unique([planId, versionNumber])
  @@index([planId, lifecycle])
  @@index([lifecycle, publishedAt])
  @@map("platform_plan_versions")
}

/// Step 14 — explicit Plan Version capability entitlement (commercial definition only).
model PlatformPlanVersionEntitlement {
  id            String   @id @default(uuid()) @db.Uuid
  planVersionId String   @db.Uuid
  catalogItemId String   @db.Uuid
  createdAt     DateTime @default(now())

  planVersion PlatformPlanVersion  @relation(fields: [planVersionId], references: [id], onDelete: Restrict)
  catalogItem HealthcareCatalogItem @relation(fields: [catalogItemId], references: [id], onDelete: Restrict)

  @@unique([planVersionId, catalogItemId])
  @@index([planVersionId])
  @@index([catalogItemId])
  @@map("platform_plan_version_entitlements")
}

/// Step 14 — typed Plan Version Limit assignment (commercial definition only).
/// Missing row = Unconfigured. unlimited=true XOR valueText set.
model PlatformPlanVersionLimit {
  id            String   @id @default(uuid()) @db.Uuid
  planVersionId String   @db.Uuid
  catalogItemId String   @db.Uuid
  unlimited     Boolean  @default(false)
  /// Exact typed value as text (INTEGER/COUNT whole numbers; DECIMAL exact digits).
  valueText     String?  @db.VarChar(64)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  planVersion PlatformPlanVersion  @relation(fields: [planVersionId], references: [id], onDelete: Restrict)
  catalogItem HealthcareCatalogItem @relation(fields: [catalogItemId], references: [id], onDelete: Restrict)

  @@unique([planVersionId, catalogItemId])
  @@index([planVersionId])
  @@index([catalogItemId])
  @@map("platform_plan_version_limits")
}

model PlatformPlanVersionTranslation {
  id               String   @id @default(uuid()) @db.Uuid
  planVersionId    String   @db.Uuid
  locale           String   @db.VarChar(10)
  releaseLabel     String   @db.VarChar(200)
  shortDescription String   @db.VarChar(500)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  planVersion PlatformPlanVersion @relation(fields: [planVersionId], references: [id], onDelete: Restrict)

  @@unique([planVersionId, locale])
  @@index([locale, releaseLabel])
  @@map("platform_plan_version_translations")
}

/// Durable Plans mutation idempotency (separate bounded context from Catalog).
model PlatformPlanIdempotencyRecord {
  id                 String   @id @default(uuid()) @db.Uuid
  actorId            String   @db.Uuid
  operation          String   @db.VarChar(64)
  idempotencyKey     String   @db.VarChar(128)
  requestHash        String   @db.VarChar(64)
  resultResourceType String   @db.VarChar(32)
  resultResourceId   String   @db.Uuid
  status             String   @db.VarChar(16)
  createdAt          DateTime @default(now())
  expiresAt          DateTime

  @@unique([actorId, operation, idempotencyKey])
  @@index([expiresAt])
  @@map("platform_plan_idempotency")
}

// ─── Phase 47 Step 15 — Platform Add-ons & Commercial Overrides ────────────
// Commercial definition SoR only. No tenantId/subscriptionId assignment FKs.
// Publish/approve do not call LicensingEngineService or change runtime.
// Empty Add-on catalog is valid (no invented addon.* seed products).

enum PlatformAddOnLifecycle {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum PlatformAddOnVersionLifecycle {
  DRAFT
  PUBLISHED
  RETIRED
}

enum PlatformAddOnLimitEffectType {
