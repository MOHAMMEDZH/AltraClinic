  linkedPlatformTenantId String?                 @db.Uuid
  rowVersion             Int                     @default(1)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  ownerRepresentative PlatformSalesRepresentative? @relation(fields: [ownerRepresentativeId], references: [id], onDelete: Restrict)
  linkedPlatformTenant PlatformTenant?             @relation(fields: [linkedPlatformTenantId], references: [id], onDelete: Restrict)
  stageHistory        PlatformSalesLeadStageHistory[]
  ownershipHistory    PlatformSalesLeadOwnershipHistory[]
  notes               PlatformSalesLeadNote[]
  /// Flexible Step 25 — Trials originating from this lead (optional).
  originatedTrials    PlatformSalesTrial[]

  @@index([ownerRepresentativeId])
  @@index([stage])
  @@index([createdAt])
  @@index([createdAt, id])
  @@index([source])
  @@index([linkedPlatformTenantId])
