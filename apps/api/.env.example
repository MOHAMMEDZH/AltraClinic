
# Copy this file to .env and fill in your values
# Never commit .env to source control

# PostgreSQL connection string
# Local Docker:  postgresql://app_user:password@localhost:5432/saas_emr?schema=public
# Production:    postgresql://user:password@host:5432/db?schema=public&sslmode=require
DATABASE_URL="postgresql://app_user:password@localhost:5432/saas_emr?schema=public"

# ── JWT ─────────────────────────────────────────────────────────────────────
# IMPORTANT: Use DIFFERENT secrets for access and refresh tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="change-this-access-secret-min-32-chars-use-crypto-random"
JWT_REFRESH_SECRET="change-this-refresh-secret-min-32-chars-different-from-access"
JWT_ACCESS_EXPIRES=900        # 15 minutes in seconds
JWT_REFRESH_EXPIRES=604800    # 7 days in seconds

# ── Platform JWT (Phase 47 Step 06 — Super Admin) ────────────────────────────
# Required in production (min 32 chars each). In non-production, unset falls back
# to JWT_ACCESS_SECRET / JWT_REFRESH_SECRET with residual shared-key risk.
# JWT_PLATFORM_ACCESS_SECRET=""
# JWT_PLATFORM_REFRESH_SECRET=""
# JWT_PLATFORM_ISSUER="booking-platform"
# JWT_PLATFORM_ACCESS_EXPIRES=900
# JWT_PLATFORM_REFRESH_EXPIRES=604800
# Exact Super Admin browser origins for credentialed CORS (comma-separated).
# SUPER_ADMIN_CORS_ORIGINS="http://127.0.0.1:5176,http://localhost:5176"

# ── Platform MFA + session security (Phase 47 Step 07) ──────────────────────
# REQUIRED whenever NODE_ENV is not exactly "test". Encrypts platform TOTP
# secrets at rest (AES-256-GCM envelope; key material is SHA-256 hashed before use).
# Never reuse JWT signing secrets. Never commit a real key.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Place the value only in your untracked local .env — not in this example file.
# PLATFORM_MFA_ENCRYPTION_KEY=""
# PLATFORM_MFA_ISSUER="Booking Platform"
# PLATFORM_MFA_ENROLLMENT_TTL_SECONDS=900
# PLATFORM_MFA_CHALLENGE_TTL_SECONDS=300
# PLATFORM_SESSION_IDLE_SECONDS=1800
# PLATFORM_SESSION_ABSOLUTE_SECONDS=43200
# PLATFORM_STEP_UP_SECONDS=300
# PLATFORM_RECOVERY_CODE_COUNT=10
# Minimum seconds between accepted interactive activity updates (server throttle).
# PLATFORM_ACTIVITY_MIN_INTERVAL_SECONDS=60
# PLATFORM_DISABLE_MFA is not supported. Do not set it in any non-test environment
# (startup fails). MFA is always mandatory for platform principals.

# ── Platform RBAC invitations (Phase 47 Step 08) ─────────────────────────────
# PLATFORM_INVITATION_TTL_SECONDS=172800
# PLATFORM_INVITATION_APP_ORIGIN="http://127.0.0.1:5176"
# PLATFORM_INVITATION_RESEND_LIMIT=5
# PLATFORM_MFA_RESET_TTL_SECONDS=86400
# Invitation delivery mode: smtp (default outside tests) | dev-mailbox (test / explicit local only)
# PLATFORM_INVITATION_DELIVERY_MODE=smtp
# APP_ENV=local|development|qa|preview|demo|uat|staging|production
# Local process mailbox requires an explicit allow flag (never for QA/preview/demo/UAT/staging/production):
# PLATFORM_ALLOW_DEV_INVITATION_MAILBOX=true
# Bootstrap: interactive TTY or --password-stdin. Do NOT set PLATFORM_BOOTSTRAP_PASSWORD for operations.
# Test-only: PLATFORM_BOOTSTRAP_PASSWORD_TEST_ONLY (NODE_ENV=test only).
# Platform DB security + Dashboard PostgreSQL reconciliation (isolated booking_test on :5433):
# RUN_PLATFORM_DB_SECURITY=true
# ALLOW_TEST_DATABASE_RESET=true
# INTEGRATION_DATABASE_URL="postgresql://booking:booking_test@localhost:5433/booking_test?schema=public"
# Commands: npm run db:test:up && npm run db:test:migrate && npm run test:platform-dashboard-db
# (also: npm run test:platform-db-security)

# Phase 47 Step 10 — Platform Dashboard aggregates (instance-local cache/rate-limit; no secrets)
# PLATFORM_DASHBOARD_CACHE_TTL_SECONDS=60
# PLATFORM_DASHBOARD_STALE_AFTER_SECONDS=120
# PLATFORM_DASHBOARD_REFRESH_RATE_LIMIT=10

# Phase 47 Step 11 — Tenant Directory / Detail reads (bounds only; instance-local rate limit)
# PLATFORM_TENANTS_DEFAULT_PAGE_SIZE=25
# PLATFORM_TENANTS_MAX_PAGE_SIZE=100
# PLATFORM_TENANTS_MAX_SEARCH_LENGTH=64
# PLATFORM_TENANTS_MAX_SUBSCRIPTION_HISTORY=10
# PLATFORM_TENANTS_MAX_ACCESS_SUMMARY_ITEMS=200
# PLATFORM_TENANTS_DIRECTORY_RATE_LIMIT=60
# Command: npm run test:platform-tenant-directory-db  (requires db:test:up + db:test:migrate)

# ── Platform Plans (Step 13) ─────────────────────────────────────────────────
# PLATFORM_PLANS_ENABLED=true
# PLATFORM_PLANS_MUTATION_RATE_LIMIT=60
# PLATFORM_PLANS_HIGH_IMPACT_RATE_LIMIT=30
# PLATFORM_PLANS_READ_HEAVY_RATE_LIMIT=120
# Commands: npm run test:platform-plans-db | test:platform-plans-migration | seed:platform-plans
# ── App ──────────────────────────────────────────────────────────────────────
NODE_ENV="development"
PORT=3000

# Comma-separated browser origins for CORS (clinic + portal + super-admin).
# Never use *. credentials:true requires exact origins.
# CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5175,http://127.0.0.1:5176"

# ── Email (set to smtp/sendgrid/ses in production) ───────────────────────────
# EMAIL_ADAPTER="console"   # console (default dev), sendgrid, ses
# SENDGRID_API_KEY=""
# SES_REGION="us-east-1"

# ── Redis ────────────────────────────────────────────────────────────────────
# Single-node (development / staging):
REDIS_URL="redis://localhost:6379"
# Redis Cluster (production): comma-separated host:port pairs
# REDIS_CLUSTER_NODES="10.0.0.1:6379,10.0.0.2:6379,10.0.0.3:6379"
# Optional password for Redis AUTH
# REDIS_PASSWORD=""
# Key prefix (default: "app"). Override per environment to share one Redis instance.
REDIS_KEY_PREFIX="app"
# Database index (0–15). Ignored in Cluster mode.
REDIS_DB=0
# Connection timeout ms (default: 5000)
REDIS_CONNECT_TIMEOUT_MS=5000
# Graceful degradation: if true, Redis errors log a warning but do not crash the app.
# Set to false in production to fail fast on Redis connectivity issues.
REDIS_OPTIONAL=true

# ── AI inference (optional — Gemini preferred when set) ───────────────────────
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
# OPENAI_API_KEY=""
# OPENAI_MODEL="gpt-4o-mini"

# ── Media Storage ─────────────────────────────────────────────────────────────
# Backend: local (dev) | s3 (production — Phase 2)
MEDIA_STORAGE_PATH="./storage/media"
# Max upload size in bytes (default 50 MB)
MEDIA_MAX_FILE_SIZE_BYTES=52428800
# Virus scanner: noop (dev) | clamav | cloud (production)
MEDIA_VIRUS_SCANNER="noop"

# ── Import/Export Center (Phase 42 — dormant by default) ─────────────────────
# When false (default): hub APIs reject execution; worker does not consume jobs.
IMPORT_EXPORT_CENTER_ENABLED=false
# Durable roots for import uploads and export artifacts (set in production).
# IMPORT_EXPORT_TEMP_PATH="./storage/import-export"
# IMPORT_EXPORT_ARTIFACT_PATH="./storage/import-export/artifacts"
# Production enablement also requires MEDIA_VIRUS_SCANNER != noop (see Media section).
# Workers/schedulers: BACKGROUND_WORKERS_ENABLED / BACKGROUND_SCHEDULERS_ENABLED (see BACKGROUND-ARCHITECTURE.md)

# Phase 43a — Backup & Restore Center (all default OFF; no execution in 43a)
BACKUP_RESTORE_CENTER_ENABLED=false
BACKUP_CENTER_ENABLED=false
BACKUP_RESTORE_ENABLED=false
BACKUP_VERIFY_ENABLED=false
BACKUP_SCHEDULER_ENABLED=false
# BACKUP_RESTORE_DEFAULT_RETENTION_DAYS=30
# BACKUP_RESTORE_ARTIFACT_PATH=  (unconfigured until later phases)
# BACKUP_RESTORE_ENCRYPTION_KEY_REF=  (no secrets in repo)

# Phase 44a — API Keys & Integrations Center (all default OFF; no execution in 44a)
API_KEYS_INTEGRATIONS_CENTER_ENABLED=false
INTEGRATIONS_WEBHOOKS_ENABLED=false
INTEGRATIONS_INBOUND_ENABLED=false
INTEGRATIONS_SERVICE_ACCOUNTS_ENABLED=false
INTEGRATIONS_LEGACY_SETTINGS_KEYS_READ=false
# API_CREDENTIAL_PEPPER_REF=  (required for later readiness; unset → pepperReady=false)
# INTEGRATIONS_SECRET_KEY_REF=  (recoverable secrets envelope; unset → secretStoreReady=false)
# Queue name reserved: integrations-webhooks (not wired in 44a)

# Phase 45a — System Monitoring & Observability Center (all default OFF; foundation only)
SYSTEM_MONITORING_OBSERVABILITY_ENABLED=false
OBSERVABILITY_METRICS_ENABLED=false
OBSERVABILITY_LOGGING_ENABLED=false
OBSERVABILITY_TRACING_ENABLED=false
OBSERVABILITY_ALERTING_ENABLED=false
OBSERVABILITY_TENANT_DASHBOARD_ENABLED=false
# OBSERVABILITY_METRICS_RETENTION_DAYS=14
# OBSERVABILITY_LOGS_RETENTION_DAYS=14
# OBSERVABILITY_TRACES_RETENTION_DAYS=7
# OBSERVABILITY_DEFAULT_TRACE_SAMPLE_RATIO=0.1
# Storage/export ports are null/unconfigured in 45a (no pipelines)

# Phase 46a — Patient Portal Center (all default OFF; foundation only — no identity/PHI)
PATIENT_PORTAL_CENTER_ENABLED=false
PATIENT_PORTAL_APPOINTMENTS_ENABLED=false
PATIENT_PORTAL_CAREGIVER_ENABLED=false
PATIENT_PORTAL_PROFILE_ENABLED=false
PATIENT_PORTAL_RECORDS_ENABLED=false
PATIENT_PORTAL_MESSAGING_ENABLED=false
PATIENT_PORTAL_BILLING_ENABLED=false
PATIENT_PORTAL_PAYMENTS_ENABLED=false
PATIENT_PORTAL_DOCUMENTS_ENABLED=false

# Comma-separated IPs of trusted reverse proxies (nginx, AWS ALB, Cloudflare).
# When set, X-Forwarded-For is trusted ONLY from these IPs for rate limiting.
# Leave empty in development to use direct socket IP (prevents XFF spoofing).
# TRUSTED_PROXY_IPS="10.0.0.1,10.0.0.2"

# ── Step 17 Effective Entitlement Runtime ────────────────────────────────────
# When false/off/0, LicensingEngineService uses pure LEGACY matrices and ignores
# Step 16 activation snapshots (explicit rollback restore of legacy for all tenants).
# Default true. Independent of Step 16 commercial admin.
# EFFECTIVE_ENTITLEMENT_RUNTIME_ENABLED=true
#
# Option B process-local cache (optimization only). Identity is always re-read from
# PostgreSQL before cache reuse — safe across multi-instance without a shared bus.
# EFFECTIVE_ENTITLEMENT_CACHE_ENABLED=true

# ── Supplemental Capability U01 — Usage Metering & Limit Enforcement ─────────
# Additive; not Flexible roadmap Step 18. Defaults OFF until explicitly enabled.
# USAGE_METERING_ENABLED=false
# USAGE_METERING_ENFORCEMENT_ENABLED=false
# USAGE_METERING_INGESTION_ENABLED=false
# Historical migration folder name retains …_step18_usage_metering for integrity only.

# Flexible Step 17 — Tenant Creation and Provisioning (default OFF until acceptance)
# TENANT_PROVISIONING_ENABLED=false
# Enable only after Step 17 acceptance: set TENANT_PROVISIONING_ENABLED=true and restart the API.

# Flexible Step 19 — Tenant Lifecycle Actions (default OFF)
# TENANT_LIFECYCLE_ENABLED=false
# Enable only after Step 19 acceptance: set TENANT_LIFECYCLE_ENABLED=true and restart the API.
# Frontend cannot bypass this gate. Platform Owner cannot bypass when disabled.

# Flexible Step 20 — Feature Flags and Global Settings (default OFF)
# FEATURE_FLAGS_SETTINGS_ENABLED=false
# Enable only after Step 20 acceptance: set FEATURE_FLAGS_SETTINGS_ENABLED=true and restart the API.

# Flexible Step 21 — Audit Center (default OFF). Domain audit writes remain active regardless.
# AUDIT_CENTER_ENABLED=false
# Enable only after Step 21 acceptance: set AUDIT_CENTER_ENABLED=true and restart the API.

# Flexible Step 22 — Operations Console (default OFF). Aggregation only; no second monitoring stack.
# OPERATIONS_CONSOLE_ENABLED=false
# Enable only after Step 22 acceptance: set OPERATIONS_CONSOLE_ENABLED=true and restart the API.
# Operational flags never grant commercial entitlements. Secrets remain in env / secret store.
