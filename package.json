{
  "name": "booking-system",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:dashboard": "npm run dev --workspace=@booking/clinic-dashboard",
    "build:dashboard": "npm run build --workspace=@booking/clinic-dashboard",
    "test:dashboard": "npm run test --workspace=@booking/clinic-dashboard",
    "test:e2e:dashboard": "npm run test:e2e --workspace=@booking/clinic-dashboard",
    "dev:api": "npm run dev --workspace=booking-system-api",
    "dev:patient-portal": "npm run dev --workspace=@booking/patient-portal",
    "build:patient-portal": "npm run build --workspace=@booking/patient-portal",
    "test:patient-portal": "npm run test --workspace=@booking/patient-portal",
    "dev:super-admin": "npm run dev --workspace=@booking/super-admin",
    "build:super-admin": "npm run build --workspace=@booking/super-admin",
    "test:super-admin": "npm run test --workspace=@booking/super-admin"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "multer": "2.2.0",
    "nodemailer": "9.0.5",
    "socket.io-parser": "4.2.7",
    "ws": "8.21.3",
    "brace-expansion": "2.1.4",
    "nanoid@3": "3.3.18",
    "nanoid@5": "5.1.16",
    "postcss": {
      "nanoid": "3.3.18"
    },
    "docx": {
      "nanoid": "5.1.16"
    },
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "3.14.2"
    }
  }
}
