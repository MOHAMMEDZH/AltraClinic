{
  "$schema": "./design-tokens.schema.json",
  "meta": {
    "version": "2026-06-15.v1",
    "description": "Machine-readable design tokens for the healthcare platform. Source of truth: docs/DESIGN_SYSTEM_BLUEPRINT.md",
    "defaultLocale": "ar-SY",
    "defaultDirection": "rtl",
    "defaultTheme": "light"
  },
  "color": {
    "brand": {
      "primary": {
        "50": "#F0F9F6",
        "100": "#D4EFE7",
        "200": "#A8DED0",
        "300": "#7DCEB8",
        "400": "#51BDA1",
        "500": "#26AD89",
        "600": "#1E8A6F",
        "700": "#166755",
        "800": "#0E443B",
        "900": "#062221"
      },
      "secondary": {
        "50": "#F0F4F9",
        "100": "#D4DFF0",
        "200": "#A8BFE0",
        "300": "#7D9FD1",
        "400": "#517FC1",
        "500": "#265FB2",
        "600": "#1E4A8E",
        "700": "#16356A",
        "800": "#0E2046",
        "900": "#062022"
      }
    },
    "semantic": {
      "success": { "light": "#16A34A", "dark": "#4ADE80" },
      "warning": { "light": "#D97706", "dark": "#FBBF24" },
      "error": { "light": "#DC2626", "dark": "#F87171" },
      "info": { "light": "#2563EB", "dark": "#60A5FA" },
      "clinical": {
        "critical": { "light": "#B91C1C", "dark": "#FCA5A5" },
        "urgent": { "light": "#EA580C", "dark": "#FDBA74" },
        "stable": { "light": "#16A34A", "dark": "#86EFAC" },
        "pending": { "light": "#CA8A04", "dark": "#FDE047" },
        "inactive": { "light": "#737373", "dark": "#A3A3A3" }
      }
    },
    "neutral": {
      "50": "#FAFAFA",
      "100": "#F5F5F5",
      "200": "#E5E5E5",
      "300": "#D4D4D4",
      "400": "#A3A3A3",
      "500": "#737373",
      "600": "#525252",
      "700": "#404040",
      "800": "#262626",
      "900": "#171717"
    },
    "surface": {
      "light": {
        "background": "#FAFAFA",
        "surface": "#FFFFFF",
        "surfaceRaised": "#FFFFFF",
        "border": "#E5E5E5",
        "textPrimary": "#262626",
        "textSecondary": "#525252",
        "textTertiary": "#737373",
        "focusRing": "#26AD89"
      },
      "dark": {
        "background": "#121212",
        "surface": "#1E1E1E",
        "surfaceRaised": "#2A2A2A",
        "border": "#404040",
        "textPrimary": "#FAFAFA",
        "textSecondary": "#D4D4D4",
        "textTertiary": "#A3A3A3",
        "focusRing": "#51BDA1"
      }
    }
  },
  "typography": {
    "fontFamily": {
      "arabic": "\"IBM Plex Sans Arabic\", \"Noto Sans Arabic\", system-ui, sans-serif",
      "latin": "\"IBM Plex Sans\", \"Inter\", system-ui, sans-serif",
      "mono": "\"IBM Plex Mono\", \"Courier New\", monospace"
    },
    "scale": {
      "display": { "size": "2.25rem", "lineHeight": "2.75rem", "weight": 700 },
      "h1": { "size": "2rem", "lineHeight": "2.5rem", "weight": 700 },
      "h2": { "size": "1.5rem", "lineHeight": "2rem", "weight": 600 },
      "h3": { "size": "1.25rem", "lineHeight": "1.75rem", "weight": 600 },
      "bodyLg": { "size": "1rem", "lineHeight": "1.5rem", "weight": 400 },
      "body": { "size": "0.875rem", "lineHeight": "1.25rem", "weight": 400 },
      "bodySm": { "size": "0.75rem", "lineHeight": "1rem", "weight": 400 },
      "caption": { "size": "0.6875rem", "lineHeight": "1rem", "weight": 500 },
      "label": { "size": "0.875rem", "lineHeight": "1.25rem", "weight": 500 }
    },
    "arabic": {
      "letterSpacing": "0",
      "wordSpacing": "0.05em"
    }
  },
  "spacing": {
    "unit": 4,
    "scale": {
      "0": "0",
      "1": "4px",
      "2": "8px",
      "3": "12px",
      "4": "16px",
      "5": "20px",
      "6": "24px",
      "8": "32px",
      "10": "40px",
      "12": "48px",
      "16": "64px",
      "20": "80px"
    },
    "layout": {
      "sidebarExpanded": "260px",
      "sidebarCollapsed": "72px",
      "headerHeight": "56px",
      "contentMaxWidth": "1440px",
      "formMaxWidth": "720px",
      "modalSm": "480px",
      "modalLg": "680px"
    }
  },
  "radius": {
    "sm": "4px",
    "md": "6px",
    "lg": "8px",
    "xl": "12px",
    "full": "9999px"
  },
  "elevation": {
    "0": "none",
    "1": "0 1px 2px rgba(0,0,0,0.05)",
    "2": "0 4px 6px rgba(0,0,0,0.08)",
    "3": "0 10px 15px rgba(0,0,0,0.10)",
    "4": "0 20px 25px rgba(0,0,0,0.12)"
  },
  "zIndex": {
    "dropdown": 10,
    "sticky": 20,
    "sidebar": 30,
    "header": 40,
    "overlay": 100,
    "modal": 110,
    "toast": 1000
  },
  "motion": {
    "durationFast": "120ms",
    "durationNormal": "200ms",
    "durationSlow": "320ms",
    "easing": "cubic-bezier(0.4, 0, 0.2, 1)"
  },
  "breakpoint": {
    "sm": "640px",
    "md": "768px",
    "lg": "1024px",
    "xl": "1280px",
    "2xl": "1536px"
  }
}
